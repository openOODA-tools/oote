// # Theme Config Resolver - Environment and File Hydration
//
// Logline: Resolves active theme, lighting mode, and border geometry with automated calendar and circadian detection.
//
// Setup: Requires FsReadCap and EnvCap. Degrades gracefully to defaults if paths are unreadable.
//
// Beats:
//   1. Resolve primary config file path (~/.openooda/theme.oot).
//   2. Probe environment variables for explicit theme and mode overrides.
//   3. Read configuration file and evaluate dynamic calendar and circadian auto modes.
//   4. Evaluate NO_COLOR and terminal capabilities for output degradation.

import "std/fs/file/path.oo";
import "std/fs/file/file_reader.oo";
import "std/fs/process/env.oo";
import "presets/calendar.oo";
import "config_reader.oo";
import "clock.oo";

pub fn env_lookup(env: &EnvCap, name: String) -> String {
    let r: Result[String, String] = env_get(env, name);
    return match r { Ok(s) => s, Err(_) => "" };
}

pub fn get_theme_config_path(env: &EnvCap) -> String {
    let ooda_home: String = env_lookup(env, "OODA_HOME");
    if ooda_home != "" {
        return path_join(path_join(ooda_home, ".openooda"), "theme.oot");
    }
    let home: String = env_lookup(env, "HOME");
    if home != "" {
        return path_join(path_join(home, ".openooda"), "theme.oot");
    }
    return "theme.oot";
}

pub fn read_config_content(fs_r: &FsReadCap, env: &EnvCap) -> String {
    let path: String = get_theme_config_path(env);
    if !path_exists(fs_r, path) { return ""; }
    let open_res: Result[FileReader, String] = file_reader_open(fs_r, path);
    let reader: FileReader = match open_res { Ok(r) => r, Err(_) => return "" };
    let read_res: Result[String, String] = file_reader_read_all(fs_r, reader);
    return match read_res { Ok(s) => s, Err(_) => "" };
}

pub fn resolve_active_theme(fs_r: &FsReadCap, env: &EnvCap) -> String {
    let env_theme: String = env_lookup(env, "OODA_THEME");
    let content: String = read_config_content(fs_r, env);
    let cfg_theme: String = parse_theme_from_oot(content);
    let target: String = if env_theme != "" { env_theme } else if cfg_theme != "" { cfg_theme } else { "auto" };
    if target != "auto" { return target; }

    let dt: CalendarDate = clock_from_rtc(fs_r);
    let mut m: Int = if dt.month > 0 { dt.month } else { 10 };
    let mut d: Int = if dt.day > 0 { dt.day } else { 5 };
    let env_date: String = env_lookup(env, "OODA_DATE");
    if chars_len(env_date) >= 10 {
        m = parse_two_digits(env_date, 5);
        d = parse_two_digits(env_date, 8);
    }
    let env_m: String = env_lookup(env, "OODA_MONTH");
    if env_m != "" { m = parse_int(env_m); }
    let env_d: String = env_lookup(env, "OODA_DAY");
    if env_d != "" { d = parse_int(env_d); }
    return calendar_auto_theme(m, d);
}

pub fn resolve_active_mode(fs_r: &FsReadCap, env: &EnvCap) -> Bool {
    let env_mode: String = env_lookup(env, "OODA_MODE");
    let content: String = read_config_content(fs_r, env);
    let cfg_mode: String = parse_mode_from_oot(content);
    let target: String = if env_mode != "" { env_mode } else if cfg_mode != "" { cfg_mode } else { "auto" };
    if target == "dark" { return true; }
    if target == "light" { return false; }

    let env_h: String = env_lookup(env, "OODA_HOUR");
    if env_h != "" {
        let h: Int = parse_int(env_h);
        return clock_is_dark(h);
    }
    let dt: CalendarDate = clock_from_rtc(fs_r);
    let tz_s: String = env_lookup(env, "OODA_TZ_OFFSET");
    let mut h: Int = if dt.year > 0 { dt.hour } else { 12 };
    if tz_s != "" {
        let offset: Int = parse_int(tz_s);
        h = (h + offset) % 24;
        if h < 0 { h = h + 24; }
    }
    return clock_is_dark(h);
}

pub fn resolve_active_border(fs_r: &FsReadCap, env: &EnvCap) -> String {
    let env_b: String = env_lookup(env, "OODA_BORDER");
    if env_b != "" { return env_b; }
    let content: String = read_config_content(fs_r, env);
    let cfg_b: String = parse_border_from_oot(content);
    if cfg_b != "" { return cfg_b; }
    return "round";
}

pub fn is_color_enabled(env: &EnvCap, cli_no_color: Bool) -> Bool {
    if cli_no_color { return false; }
    let no_col: String = env_lookup(env, "OODA_NO_COLOR");
    if no_col != "" { return false; }
    let oo_no_col: String = env_lookup(env, "OO_NO_COLOR");
    if oo_no_col != "" { return false; }
    let std_no_col: String = env_lookup(env, "NO_COLOR");
    if std_no_col != "" { return false; }
    let term: String = env_lookup(env, "TERM");
    if term == "dumb" { return false; }
    return true;
}

pub fn is_truecolor_enabled(env: &EnvCap) -> Bool {
    let ct: String = env_lookup(env, "COLORTERM");
    if ct == "truecolor" || ct == "24bit" { return true; }
    return true;
}
