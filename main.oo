// # oote Main Entry Point - CLI Driver
//
// Logline: Command-line interface driver for listing, previewing, persisting openOODA themes and MCP serving.
//
// Setup: Requires FsReadCap, FsWriteCap, EnvCap, and ProcessCap under sovereign OCap discipline.
//
// Beats:
//   1. Parse command verbs: list, current, preview, set, get, mode, border, mascot, glyph, --mcp, help, version.
//   2. Route to specialized subcommand handlers or launch MCP stdio server.
//   3. Manage terminal capability flags and return exit status.
//
import "store/theme_config.oo";
import "cli/anchor.oo";
import "ipc/anchor.oo";

pub fn main(fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, proc_cap: &ProcessCap, args: List[String]) -> Result[Int, String] {
    let argc: Int = list_len(args);
    let color_on: Bool = is_color_enabled(env, false);
    let tc_on: Bool = is_truecolor_enabled(env);

    if argc == 0 { return Ok(cmd_help()); }
    let verb: String = list_get(args, 0);

    if verb == "--help" || verb == "-h" || verb == "help" { return Ok(cmd_help()); }
    if verb == "--version" || verb == "-v" || verb == "version" {
        print("oote 0.2.0 (openOODA sovereign theme engine)\n");
        return Ok(0);
    }
    if verb == "--mcp" {
        return Ok(run_mcp_server(fs_r, env));
    }
    if verb == "list" { return Ok(cmd_list(fs_r, env, color_on, tc_on)); }
    if verb == "current" {
        let opt: String = if argc > 1 { list_get(args, 1) } else { "" };
        return Ok(cmd_query(fs_r, env, false, opt, color_on, tc_on));
    }
    if verb == "get" {
        if argc <= 1 { print("oote: missing token argument\nUsage: oote get <token>\n"); return Ok(1); }
        return Ok(cmd_query(fs_r, env, true, list_get(args, 1), color_on, tc_on));
    }
    if verb == "preview" { return Ok(cmd_preview(fs_r, env, args, color_on, tc_on)); }
    if verb == "set" { return Ok(cmd_set(fs_r, fs_w, env, args)); }
    if verb == "mode" || verb == "border" { return Ok(cmd_mode_border(fs_r, fs_w, env, verb, args)); }
    if verb == "mascot" { return Ok(cmd_mascot_glyph(fs_r, env, args, false, color_on, tc_on)); }
    if verb == "glyph" { return Ok(cmd_mascot_glyph(fs_r, env, args, true, color_on, tc_on)); }

    print("oote: unknown command '" + verb + "'\nTry 'oote --help' for usage.\n");
    return Ok(1);
}
