// # Dracula Preset - Dark Gothic High-Contrast Palette
//
// Logline: Famous dark gothic theme featuring vibrant purple, pink, and cyan highlights over midnight slate.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Define Dracula color swatches (Purple, Pink, Cyan, Green, Orange, Red).
//   2. Map UI chrome, status indicators, and diff tokens.
//   3. Map syntax, shell, and observability tokens.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn drac_ui_token(tok: String) -> Color {
    if tok == "ui_bg" { return color_hex("#282A36", 0); }
    if tok == "ui_fg" { return color_hex("#F8F8F2", 37); }
    if tok == "ui_surface" { return color_hex("#44475A", 0); }
    if tok == "ui_border" { return color_hex("#6272A4", 90); }
    if tok == "ui_border_accent" { return color_hex("#BD93F9", 35); }
    if tok == "ui_muted" { return color_hex("#6272A4", 90); }
    if tok == "ui_dim" { return color_hex("#44475A", 90); }
    if tok == "ui_accent" { return color_hex("#BD93F9", 35); }
    return color_none();
}

fn drac_status_diff_token(tok: String) -> Color {
    if tok == "status_success" { return color_hex("#50FA7B", 32); }
    if tok == "status_warning" { return color_hex("#FFB86C", 33); }
    if tok == "status_error" { return color_hex("#FF5555", 31); }
    if tok == "status_info" { return color_hex("#8BE9FD", 36); }
    if tok == "diff_added" { return color_hex("#50FA7B", 32); }
    if tok == "diff_removed" { return color_hex("#FF5555", 31); }
    if tok == "diff_context" { return color_hex("#6272A4", 90); }
    if tok == "diff_header" { return color_hex("#FF79C6", 35); }
    return color_none();
}

fn drac_syntax_token(tok: String) -> Color {
    if tok == "syntax_keyword" { return color_hex("#FF79C6", 35); }
    if tok == "syntax_string" { return color_hex("#F1FA8C", 33); }
    if tok == "syntax_number" { return color_hex("#BD93F9", 35); }
    if tok == "syntax_type" { return color_hex("#8BE9FD", 36); }
    if tok == "syntax_fn" { return color_hex("#50FA7B", 32); }
    if tok == "syntax_var" { return color_hex("#F8F8F2", 37); }
    if tok == "syntax_comment" { return color_hex("#6272A4", 90); }
    if tok == "syntax_op" { return color_hex("#FF79C6", 35); }
    if tok == "syntax_punct" { return color_hex("#F8F8F2", 37); }
    return color_none();
}

fn drac_shell_log_token(tok: String) -> Color {
    if tok == "match_hit" { return color_hex("#FFB86C", 33); }
    if tok == "match_path" { return color_hex("#8BE9FD", 36); }
    if tok == "match_line_num" { return color_hex("#50FA7B", 32); }
    if tok == "match_col_num" { return color_hex("#BD93F9", 35); }
    if tok == "shell_prompt" { return color_hex("#BD93F9", 35); }
    if tok == "shell_builtin" { return color_hex("#8BE9FD", 36); }
    if tok == "shell_host_bin" { return color_hex("#50FA7B", 32); }
    if tok == "shell_nav" { return color_hex("#FF79C6", 35); }
    if tok == "shell_intent" { return color_hex("#FFB86C", 33); }
    if tok == "log_trace" { return color_hex("#44475A", 90); }
    if tok == "log_debug" { return color_hex("#6272A4", 90); }
    if tok == "log_info" { return color_hex("#8BE9FD", 36); }
    if tok == "log_warn" { return color_hex("#FFB86C", 33); }
    if tok == "log_error" { return color_hex("#FF5555", 31); }
    return color_none();
}

pub fn theme_dracula_color(tok: String) -> Color {
    let c1: Color = drac_ui_token(tok);
    if c1.is_set { return c1; }
    let c2: Color = drac_status_diff_token(tok);
    if c2.is_set { return c2; }
    let c3: Color = drac_syntax_token(tok);
    if c3.is_set { return c3; }
    return drac_shell_log_token(tok);
}

pub fn theme_dracula_meta() -> ThemeMeta {
    return theme_meta_new("dracula", "Zeno Rocha", true, "Gothic high-contrast vibrant dark palette");
}
