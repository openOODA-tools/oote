// # Yule Preset - Evergreen Pine and Cranberry Crimson
//
// Logline: Winter holiday theme featuring lush evergreen needle tones, cranberry crimson, and warm brass glow.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for festive winter nights and hearth light.
//   2. Map status alerts and diff tokens with evergreen, gold, and crimson.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn yule_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#0A140F", 0); }
        if tok == "ui_fg" { return color_hex("#ECFDF5", 37); }
        if tok == "ui_surface" { return color_hex("#122119", 0); }
        if tok == "ui_border" { return color_hex("#23543A", 90); }
        if tok == "ui_border_accent" { return color_hex("#EF4444", 31); }
        if tok == "ui_muted" { return color_hex("#6EE7B7", 90); }
        if tok == "ui_dim" { return color_hex("#1A3A2A", 90); }
        if tok == "ui_accent" { return color_hex("#EF4444", 31); }
    } else {
        if tok == "ui_bg" { return color_hex("#F0FDF4", 0); }
        if tok == "ui_fg" { return color_hex("#14532D", 30); }
        if tok == "ui_surface" { return color_hex("#DCFCE7", 0); }
        if tok == "ui_border" { return color_hex("#86EFAC", 90); }
        if tok == "ui_border_accent" { return color_hex("#B91C1C", 31); }
        if tok == "ui_muted" { return color_hex("#15803D", 90); }
        if tok == "ui_dim" { return color_hex("#4ADE80", 90); }
        if tok == "ui_accent" { return color_hex("#B91C1C", 31); }
    }
    return color_none();
}

fn yule_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#34D399", 32); }
        if tok == "status_warning" { return color_hex("#FBBF24", 33); }
        if tok == "status_error" { return color_hex("#EF4444", 31); }
        if tok == "status_info" { return color_hex("#67E8F9", 36); }
        if tok == "diff_added" { return color_hex("#34D399", 32); }
        if tok == "diff_removed" { return color_hex("#EF4444", 31); }
        if tok == "diff_context" { return color_hex("#6EE7B7", 90); }
        if tok == "diff_header" { return color_hex("#FBBF24", 33); }
    } else {
        if tok == "status_success" { return color_hex("#15803D", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#B91C1C", 31); }
        if tok == "status_info" { return color_hex("#0E7490", 36); }
        if tok == "diff_added" { return color_hex("#15803D", 32); }
        if tok == "diff_removed" { return color_hex("#B91C1C", 31); }
        if tok == "diff_context" { return color_hex("#15803D", 90); }
        if tok == "diff_header" { return color_hex("#B45309", 33); }
    }
    return color_none();
}

fn yule_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#F87171", 31); }
        if tok == "syntax_string" { return color_hex("#34D399", 32); }
        if tok == "syntax_number" { return color_hex("#FBBF24", 33); }
        if tok == "syntax_type" { return color_hex("#6EE7B7", 32); }
        if tok == "syntax_fn" { return color_hex("#FCD34D", 33); }
        if tok == "syntax_var" { return color_hex("#ECFDF5", 37); }
        if tok == "syntax_comment" { return color_hex("#4E8268", 90); }
        if tok == "syntax_op" { return color_hex("#F87171", 31); }
        if tok == "syntax_punct" { return color_hex("#A7F3D0", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#991B1B", 31); }
        if tok == "syntax_string" { return color_hex("#15803D", 32); }
        if tok == "syntax_number" { return color_hex("#B45309", 33); }
        if tok == "syntax_type" { return color_hex("#166534", 32); }
        if tok == "syntax_fn" { return color_hex("#854D0E", 33); }
        if tok == "syntax_var" { return color_hex("#14532D", 30); }
        if tok == "syntax_comment" { return color_hex("#15803D", 90); }
        if tok == "syntax_op" { return color_hex("#991B1B", 31); }
        if tok == "syntax_punct" { return color_hex("#166534", 90); }
    }
    return color_none();
}

fn yule_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FBBF24", 33); }
        if tok == "match_path" { return color_hex("#6EE7B7", 32); }
        if tok == "match_line_num" { return color_hex("#34D399", 32); }
        if tok == "match_col_num" { return color_hex("#EF4444", 31); }
        if tok == "shell_prompt" { return color_hex("#EF4444", 31); }
        if tok == "shell_builtin" { return color_hex("#FBBF24", 33); }
        if tok == "shell_host_bin" { return color_hex("#34D399", 32); }
        if tok == "shell_nav" { return color_hex("#6EE7B7", 32); }
        if tok == "shell_intent" { return color_hex("#F87171", 31); }
        if tok == "log_trace" { return color_hex("#1A3A2A", 90); }
        if tok == "log_debug" { return color_hex("#4E8268", 90); }
        if tok == "log_info" { return color_hex("#6EE7B7", 32); }
        if tok == "log_warn" { return color_hex("#FBBF24", 33); }
        if tok == "log_error" { return color_hex("#EF4444", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#166534", 32); }
        if tok == "match_line_num" { return color_hex("#15803D", 32); }
        if tok == "match_col_num" { return color_hex("#B91C1C", 31); }
        if tok == "shell_prompt" { return color_hex("#B91C1C", 31); }
        if tok == "shell_builtin" { return color_hex("#854D0E", 33); }
        if tok == "shell_host_bin" { return color_hex("#15803D", 32); }
        if tok == "shell_nav" { return color_hex("#166534", 32); }
        if tok == "shell_intent" { return color_hex("#991B1B", 31); }
        if tok == "log_trace" { return color_hex("#4ADE80", 90); }
        if tok == "log_debug" { return color_hex("#15803D", 90); }
        if tok == "log_info" { return color_hex("#166534", 32); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#B91C1C", 31); }
    }
    return color_none();
}

pub fn theme_yule_color(tok: String, dark: Bool) -> Color {
    let c1: Color = yule_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = yule_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = yule_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return yule_shell_log_token(tok, dark);
}

pub fn theme_yule_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("yule", "openOODA", dark, "Winter holiday evergreen pine and cranberry crimson");
}
