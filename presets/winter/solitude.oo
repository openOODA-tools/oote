// # Solitude Preset - Slate Grey and Moonlit Stillness
//
// Logline: December theme capturing silent winter woods, slate granite, and moonlit quietude.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for silent midnight and snow slate.
//   2. Map status alerts and diff tokens with teal, amber, and crimson.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn sol_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#0F1216", 0); }
        if tok == "ui_fg" { return color_hex("#F1F5F9", 37); }
        if tok == "ui_surface" { return color_hex("#191D24", 0); }
        if tok == "ui_border" { return color_hex("#475569", 90); }
        if tok == "ui_border_accent" { return color_hex("#94A3B8", 37); }
        if tok == "ui_muted" { return color_hex("#94A3B8", 90); }
        if tok == "ui_dim" { return color_hex("#334155", 90); }
        if tok == "ui_accent" { return color_hex("#94A3B8", 37); }
    } else {
        if tok == "ui_bg" { return color_hex("#F8FAFC", 0); }
        if tok == "ui_fg" { return color_hex("#1E293B", 30); }
        if tok == "ui_surface" { return color_hex("#E2E8F0", 0); }
        if tok == "ui_border" { return color_hex("#CBD5E1", 90); }
        if tok == "ui_border_accent" { return color_hex("#475569", 90); }
        if tok == "ui_muted" { return color_hex("#64748B", 90); }
        if tok == "ui_dim" { return color_hex("#94A3B8", 90); }
        if tok == "ui_accent" { return color_hex("#475569", 90); }
    }
    return color_none();
}

fn sol_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#5EEAD4", 32); }
        if tok == "status_warning" { return color_hex("#FCD34D", 33); }
        if tok == "status_error" { return color_hex("#FDA4AF", 31); }
        if tok == "status_info" { return color_hex("#A5B4FC", 34); }
        if tok == "diff_added" { return color_hex("#5EEAD4", 32); }
        if tok == "diff_removed" { return color_hex("#FDA4AF", 31); }
        if tok == "diff_context" { return color_hex("#94A3B8", 90); }
        if tok == "diff_header" { return color_hex("#A5B4FC", 34); }
    } else {
        if tok == "status_success" { return color_hex("#0F766E", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#BE123C", 31); }
        if tok == "status_info" { return color_hex("#4338CA", 34); }
        if tok == "diff_added" { return color_hex("#0F766E", 32); }
        if tok == "diff_removed" { return color_hex("#BE123C", 31); }
        if tok == "diff_context" { return color_hex("#64748B", 90); }
        if tok == "diff_header" { return color_hex("#4338CA", 34); }
    }
    return color_none();
}

fn sol_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#A5B4FC", 34); }
        if tok == "syntax_string" { return color_hex("#5EEAD4", 32); }
        if tok == "syntax_number" { return color_hex("#FCD34D", 33); }
        if tok == "syntax_type" { return color_hex("#94A3B8", 37); }
        if tok == "syntax_fn" { return color_hex("#CBD5E1", 37); }
        if tok == "syntax_var" { return color_hex("#F1F5F9", 37); }
        if tok == "syntax_comment" { return color_hex("#64748B", 90); }
        if tok == "syntax_op" { return color_hex("#A5B4FC", 34); }
        if tok == "syntax_punct" { return color_hex("#94A3B8", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#4338CA", 34); }
        if tok == "syntax_string" { return color_hex("#0F766E", 32); }
        if tok == "syntax_number" { return color_hex("#B45309", 33); }
        if tok == "syntax_type" { return color_hex("#475569", 90); }
        if tok == "syntax_fn" { return color_hex("#1E293B", 30); }
        if tok == "syntax_var" { return color_hex("#1E293B", 30); }
        if tok == "syntax_comment" { return color_hex("#64748B", 90); }
        if tok == "syntax_op" { return color_hex("#4338CA", 34); }
        if tok == "syntax_punct" { return color_hex("#64748B", 90); }
    }
    return color_none();
}

fn sol_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FCD34D", 33); }
        if tok == "match_path" { return color_hex("#A5B4FC", 34); }
        if tok == "match_line_num" { return color_hex("#5EEAD4", 32); }
        if tok == "match_col_num" { return color_hex("#FDA4AF", 31); }
        if tok == "shell_prompt" { return color_hex("#94A3B8", 37); }
        if tok == "shell_builtin" { return color_hex("#A5B4FC", 34); }
        if tok == "shell_host_bin" { return color_hex("#CBD5E1", 37); }
        if tok == "shell_nav" { return color_hex("#5EEAD4", 32); }
        if tok == "shell_intent" { return color_hex("#C084FC", 35); }
        if tok == "log_trace" { return color_hex("#334155", 90); }
        if tok == "log_debug" { return color_hex("#64748B", 90); }
        if tok == "log_info" { return color_hex("#94A3B8", 37); }
        if tok == "log_warn" { return color_hex("#FCD34D", 33); }
        if tok == "log_error" { return color_hex("#FDA4AF", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#4338CA", 34); }
        if tok == "match_line_num" { return color_hex("#0F766E", 32); }
        if tok == "match_col_num" { return color_hex("#BE123C", 31); }
        if tok == "shell_prompt" { return color_hex("#475569", 90); }
        if tok == "shell_builtin" { return color_hex("#4338CA", 34); }
        if tok == "shell_host_bin" { return color_hex("#1E293B", 30); }
        if tok == "shell_nav" { return color_hex("#0F766E", 32); }
        if tok == "shell_intent" { return color_hex("#7E22CE", 35); }
        if tok == "log_trace" { return color_hex("#94A3B8", 90); }
        if tok == "log_debug" { return color_hex("#64748B", 90); }
        if tok == "log_info" { return color_hex("#475569", 90); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#BE123C", 31); }
    }
    return color_none();
}

pub fn theme_solitude_color(tok: String, dark: Bool) -> Color {
    let c1: Color = sol_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = sol_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = sol_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return sol_shell_log_token(tok, dark);
}

pub fn theme_solitude_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("solitude", "openOODA", dark, "December silent winter woods and slate moonlight");
}
