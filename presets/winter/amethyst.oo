// # Amethyst Preset - Royal Violet and Quartz Crystal
//
// Logline: February theme evoking crystal geode facets with royal violet accents and twilight luminescence.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for violet night and quartz light.
//   2. Map status alerts and diff tokens with emerald, amber, and ruby.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn amethyst_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#120E1C", 0); }
        if tok == "ui_fg" { return color_hex("#EDE6F8", 37); }
        if tok == "ui_surface" { return color_hex("#1C172B", 0); }
        if tok == "ui_border" { return color_hex("#44355F", 90); }
        if tok == "ui_border_accent" { return color_hex("#B87BFF", 35); }
        if tok == "ui_muted" { return color_hex("#9A84B8", 90); }
        if tok == "ui_dim" { return color_hex("#33244D", 90); }
        if tok == "ui_accent" { return color_hex("#B87BFF", 35); }
    } else {
        if tok == "ui_bg" { return color_hex("#F7F2FC", 0); }
        if tok == "ui_fg" { return color_hex("#26143F", 30); }
        if tok == "ui_surface" { return color_hex("#ECE3F6", 0); }
        if tok == "ui_border" { return color_hex("#CBB8E3", 90); }
        if tok == "ui_border_accent" { return color_hex("#7E22CE", 35); }
        if tok == "ui_muted" { return color_hex("#6D548C", 90); }
        if tok == "ui_dim" { return color_hex("#9C87B8", 90); }
        if tok == "ui_accent" { return color_hex("#7E22CE", 35); }
    }
    return color_none();
}

fn amethyst_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#6EE7B7", 32); }
        if tok == "status_warning" { return color_hex("#FCD34D", 33); }
        if tok == "status_error" { return color_hex("#F472B6", 31); }
        if tok == "status_info" { return color_hex("#B87BFF", 35); }
        if tok == "diff_added" { return color_hex("#6EE7B7", 32); }
        if tok == "diff_removed" { return color_hex("#F472B6", 31); }
        if tok == "diff_context" { return color_hex("#9A84B8", 90); }
        if tok == "diff_header" { return color_hex("#B87BFF", 35); }
    } else {
        if tok == "status_success" { return color_hex("#059669", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#BE185D", 31); }
        if tok == "status_info" { return color_hex("#7E22CE", 35); }
        if tok == "diff_added" { return color_hex("#059669", 32); }
        if tok == "diff_removed" { return color_hex("#BE185D", 31); }
        if tok == "diff_context" { return color_hex("#6D548C", 90); }
        if tok == "diff_header" { return color_hex("#7E22CE", 35); }
    }
    return color_none();
}

fn amethyst_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#C084FC", 35); }
        if tok == "syntax_string" { return color_hex("#6EE7B7", 32); }
        if tok == "syntax_number" { return color_hex("#F472B6", 35); }
        if tok == "syntax_type" { return color_hex("#E879F9", 35); }
        if tok == "syntax_fn" { return color_hex("#B87BFF", 35); }
        if tok == "syntax_var" { return color_hex("#EDE6F8", 37); }
        if tok == "syntax_comment" { return color_hex("#735C94", 90); }
        if tok == "syntax_op" { return color_hex("#C084FC", 35); }
        if tok == "syntax_punct" { return color_hex("#9A84B8", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#6B21A8", 35); }
        if tok == "syntax_string" { return color_hex("#059669", 32); }
        if tok == "syntax_number" { return color_hex("#BE185D", 35); }
        if tok == "syntax_type" { return color_hex("#9333EA", 35); }
        if tok == "syntax_fn" { return color_hex("#7E22CE", 35); }
        if tok == "syntax_var" { return color_hex("#26143F", 30); }
        if tok == "syntax_comment" { return color_hex("#6D548C", 90); }
        if tok == "syntax_op" { return color_hex("#6B21A8", 35); }
        if tok == "syntax_punct" { return color_hex("#6D548C", 90); }
    }
    return color_none();
}

fn amethyst_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FCD34D", 33); }
        if tok == "match_path" { return color_hex("#B87BFF", 35); }
        if tok == "match_line_num" { return color_hex("#6EE7B7", 32); }
        if tok == "match_col_num" { return color_hex("#F472B6", 31); }
        if tok == "shell_prompt" { return color_hex("#B87BFF", 35); }
        if tok == "shell_builtin" { return color_hex("#C084FC", 35); }
        if tok == "shell_host_bin" { return color_hex("#E879F9", 35); }
        if tok == "shell_nav" { return color_hex("#6EE7B7", 32); }
        if tok == "shell_intent" { return color_hex("#F472B6", 35); }
        if tok == "log_trace" { return color_hex("#33244D", 90); }
        if tok == "log_debug" { return color_hex("#735C94", 90); }
        if tok == "log_info" { return color_hex("#B87BFF", 35); }
        if tok == "log_warn" { return color_hex("#FCD34D", 33); }
        if tok == "log_error" { return color_hex("#F472B6", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#7E22CE", 35); }
        if tok == "match_line_num" { return color_hex("#059669", 32); }
        if tok == "match_col_num" { return color_hex("#BE185D", 31); }
        if tok == "shell_prompt" { return color_hex("#7E22CE", 35); }
        if tok == "shell_builtin" { return color_hex("#6B21A8", 35); }
        if tok == "shell_host_bin" { return color_hex("#9333EA", 35); }
        if tok == "shell_nav" { return color_hex("#059669", 32); }
        if tok == "shell_intent" { return color_hex("#BE185D", 35); }
        if tok == "log_trace" { return color_hex("#9C87B8", 90); }
        if tok == "log_debug" { return color_hex("#6D548C", 90); }
        if tok == "log_info" { return color_hex("#7E22CE", 35); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#BE185D", 31); }
    }
    return color_none();
}

pub fn theme_amethyst_color(tok: String, dark: Bool) -> Color {
    let c1: Color = amethyst_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = amethyst_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = amethyst_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return amethyst_shell_log_token(tok, dark);
}

pub fn theme_amethyst_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("amethyst", "openOODA", dark, "February quartz crystals and deep royal violet");
}
