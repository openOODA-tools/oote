// # Nova Preset - New Year Champagne Sparkles and Midnight Shimmer
//
// Logline: New Year holiday theme featuring obsidian celebration canvas, champagne sparkles, and starlight silver.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for midnight party and dawn sparkle.
//   2. Map status alerts and diff tokens with champagne gold, emerald, and starlight.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn nova_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#0D0D14", 0); }
        if tok == "ui_fg" { return color_hex("#F8FAFC", 37); }
        if tok == "ui_surface" { return color_hex("#181824", 0); }
        if tok == "ui_border" { return color_hex("#4B4B6E", 90); }
        if tok == "ui_border_accent" { return color_hex("#FDE047", 33); }
        if tok == "ui_muted" { return color_hex("#9494BA", 90); }
        if tok == "ui_dim" { return color_hex("#2E2E48", 90); }
        if tok == "ui_accent" { return color_hex("#FDE047", 33); }
    } else {
        if tok == "ui_bg" { return color_hex("#FAFAFD", 0); }
        if tok == "ui_fg" { return color_hex("#18182B", 30); }
        if tok == "ui_surface" { return color_hex("#ECECF8", 0); }
        if tok == "ui_border" { return color_hex("#C5C5DE", 90); }
        if tok == "ui_border_accent" { return color_hex("#A16207", 33); }
        if tok == "ui_muted" { return color_hex("#585878", 90); }
        if tok == "ui_dim" { return color_hex("#9494BA", 90); }
        if tok == "ui_accent" { return color_hex("#A16207", 33); }
    }
    return color_none();
}

fn nova_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#4ADE80", 32); }
        if tok == "status_warning" { return color_hex("#FDE047", 33); }
        if tok == "status_error" { return color_hex("#F87171", 31); }
        if tok == "status_info" { return color_hex("#38BDF8", 36); }
        if tok == "diff_added" { return color_hex("#4ADE80", 32); }
        if tok == "diff_removed" { return color_hex("#F87171", 31); }
        if tok == "diff_context" { return color_hex("#9494BA", 90); }
        if tok == "diff_header" { return color_hex("#FDE047", 33); }
    } else {
        if tok == "status_success" { return color_hex("#16A34A", 32); }
        if tok == "status_warning" { return color_hex("#A16207", 33); }
        if tok == "status_error" { return color_hex("#DC2626", 31); }
        if tok == "status_info" { return color_hex("#0284C7", 36); }
        if tok == "diff_added" { return color_hex("#16A34A", 32); }
        if tok == "diff_removed" { return color_hex("#DC2626", 31); }
        if tok == "diff_context" { return color_hex("#585878", 90); }
        if tok == "diff_header" { return color_hex("#A16207", 33); }
    }
    return color_none();
}

fn nova_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#FDE047", 33); }
        if tok == "syntax_string" { return color_hex("#4ADE80", 32); }
        if tok == "syntax_number" { return color_hex("#F472B6", 35); }
        if tok == "syntax_type" { return color_hex("#38BDF8", 36); }
        if tok == "syntax_fn" { return color_hex("#E2E8F0", 37); }
        if tok == "syntax_var" { return color_hex("#F8FAFC", 37); }
        if tok == "syntax_comment" { return color_hex("#686894", 90); }
        if tok == "syntax_op" { return color_hex("#FDE047", 33); }
        if tok == "syntax_punct" { return color_hex("#9494BA", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#854D0E", 33); }
        if tok == "syntax_string" { return color_hex("#16A34A", 32); }
        if tok == "syntax_number" { return color_hex("#BE185D", 35); }
        if tok == "syntax_type" { return color_hex("#0284C7", 36); }
        if tok == "syntax_fn" { return color_hex("#1E1B4B", 30); }
        if tok == "syntax_var" { return color_hex("#18182B", 30); }
        if tok == "syntax_comment" { return color_hex("#686894", 90); }
        if tok == "syntax_op" { return color_hex("#854D0E", 33); }
        if tok == "syntax_punct" { return color_hex("#585878", 90); }
    }
    return color_none();
}

fn nova_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FDE047", 33); }
        if tok == "match_path" { return color_hex("#38BDF8", 36); }
        if tok == "match_line_num" { return color_hex("#4ADE80", 32); }
        if tok == "match_col_num" { return color_hex("#F87171", 31); }
        if tok == "shell_prompt" { return color_hex("#FDE047", 33); }
        if tok == "shell_builtin" { return color_hex("#38BDF8", 36); }
        if tok == "shell_host_bin" { return color_hex("#E2E8F0", 37); }
        if tok == "shell_nav" { return color_hex("#4ADE80", 32); }
        if tok == "shell_intent" { return color_hex("#F472B6", 35); }
        if tok == "log_trace" { return color_hex("#2E2E48", 90); }
        if tok == "log_debug" { return color_hex("#686894", 90); }
        if tok == "log_info" { return color_hex("#38BDF8", 36); }
        if tok == "log_warn" { return color_hex("#FDE047", 33); }
        if tok == "log_error" { return color_hex("#F87171", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#A16207", 33); }
        if tok == "match_path" { return color_hex("#0284C7", 36); }
        if tok == "match_line_num" { return color_hex("#16A34A", 32); }
        if tok == "match_col_num" { return color_hex("#DC2626", 31); }
        if tok == "shell_prompt" { return color_hex("#A16207", 33); }
        if tok == "shell_builtin" { return color_hex("#0284C7", 36); }
        if tok == "shell_host_bin" { return color_hex("#1E1B4B", 30); }
        if tok == "shell_nav" { return color_hex("#16A34A", 32); }
        if tok == "shell_intent" { return color_hex("#BE185D", 35); }
        if tok == "log_trace" { return color_hex("#9494BA", 90); }
        if tok == "log_debug" { return color_hex("#686894", 90); }
        if tok == "log_info" { return color_hex("#0284C7", 36); }
        if tok == "log_warn" { return color_hex("#A16207", 33); }
        if tok == "log_error" { return color_hex("#DC2626", 31); }
    }
    return color_none();
}

pub fn theme_nova_color(tok: String, dark: Bool) -> Color {
    let c1: Color = nova_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = nova_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = nova_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return nova_shell_log_token(tok, dark);
}

pub fn theme_nova_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("nova", "openOODA", dark, "New Year celebration champagne sparkles and starlight silver");
}
