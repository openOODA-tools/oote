// # Frost Preset - Deep Arctic Ice and Crystalline Chill
//
// Logline: Winter theme capturing subzero clarity with frosted cyan accents and glacial surfaces.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for arctic night and glacial light.
//   2. Map status alerts and diff tokens with frost cyan, teal, and crimson.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn frost_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#0B1017", 0); }
        if tok == "ui_fg" { return color_hex("#E8F1F5", 37); }
        if tok == "ui_surface" { return color_hex("#131B24", 0); }
        if tok == "ui_border" { return color_hex("#365369", 90); }
        if tok == "ui_border_accent" { return color_hex("#72D7F6", 36); }
        if tok == "ui_muted" { return color_hex("#88A4B8", 90); }
        if tok == "ui_dim" { return color_hex("#243645", 90); }
        if tok == "ui_accent" { return color_hex("#72D7F6", 36); }
    } else {
        if tok == "ui_bg" { return color_hex("#F0F6F9", 0); }
        if tok == "ui_fg" { return color_hex("#102A36", 30); }
        if tok == "ui_surface" { return color_hex("#DEEBF1", 0); }
        if tok == "ui_border" { return color_hex("#B0C8D6", 90); }
        if tok == "ui_border_accent" { return color_hex("#0284C7", 34); }
        if tok == "ui_muted" { return color_hex("#4B6777", 90); }
        if tok == "ui_dim" { return color_hex("#7E9BAA", 90); }
        if tok == "ui_accent" { return color_hex("#0284C7", 34); }
    }
    return color_none();
}

fn frost_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#4ED8A3", 32); }
        if tok == "status_warning" { return color_hex("#FCD34D", 33); }
        if tok == "status_error" { return color_hex("#F87171", 31); }
        if tok == "status_info" { return color_hex("#72D7F6", 36); }
        if tok == "diff_added" { return color_hex("#4ED8A3", 32); }
        if tok == "diff_removed" { return color_hex("#F87171", 31); }
        if tok == "diff_context" { return color_hex("#88A4B8", 90); }
        if tok == "diff_header" { return color_hex("#72D7F6", 36); }
    } else {
        if tok == "status_success" { return color_hex("#0D9488", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#BE123C", 31); }
        if tok == "status_info" { return color_hex("#0284C7", 34); }
        if tok == "diff_added" { return color_hex("#0D9488", 32); }
        if tok == "diff_removed" { return color_hex("#BE123C", 31); }
        if tok == "diff_context" { return color_hex("#4B6777", 90); }
        if tok == "diff_header" { return color_hex("#0284C7", 34); }
    }
    return color_none();
}

fn frost_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#72D7F6", 36); }
        if tok == "syntax_string" { return color_hex("#4ED8A3", 32); }
        if tok == "syntax_number" { return color_hex("#A5B4FC", 35); }
        if tok == "syntax_type" { return color_hex("#38BDF8", 36); }
        if tok == "syntax_fn" { return color_hex("#72D7F6", 36); }
        if tok == "syntax_var" { return color_hex("#E8F1F5", 37); }
        if tok == "syntax_comment" { return color_hex("#56748A", 90); }
        if tok == "syntax_op" { return color_hex("#72D7F6", 36); }
        if tok == "syntax_punct" { return color_hex("#88A4B8", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#0369A1", 34); }
        if tok == "syntax_string" { return color_hex("#0D9488", 32); }
        if tok == "syntax_number" { return color_hex("#6366F1", 35); }
        if tok == "syntax_type" { return color_hex("#0284C7", 34); }
        if tok == "syntax_fn" { return color_hex("#0284C7", 34); }
        if tok == "syntax_var" { return color_hex("#102A36", 30); }
        if tok == "syntax_comment" { return color_hex("#64748B", 90); }
        if tok == "syntax_op" { return color_hex("#0369A1", 34); }
        if tok == "syntax_punct" { return color_hex("#4B6777", 90); }
    }
    return color_none();
}

fn frost_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FCD34D", 33); }
        if tok == "match_path" { return color_hex("#72D7F6", 36); }
        if tok == "match_line_num" { return color_hex("#4ED8A3", 32); }
        if tok == "match_col_num" { return color_hex("#F87171", 31); }
        if tok == "shell_prompt" { return color_hex("#72D7F6", 36); }
        if tok == "shell_builtin" { return color_hex("#38BDF8", 36); }
        if tok == "shell_host_bin" { return color_hex("#A5B4FC", 35); }
        if tok == "shell_nav" { return color_hex("#4ED8A3", 32); }
        if tok == "shell_intent" { return color_hex("#C084FC", 35); }
        if tok == "log_trace" { return color_hex("#243645", 90); }
        if tok == "log_debug" { return color_hex("#56748A", 90); }
        if tok == "log_info" { return color_hex("#72D7F6", 36); }
        if tok == "log_warn" { return color_hex("#FCD34D", 33); }
        if tok == "log_error" { return color_hex("#F87171", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#0284C7", 34); }
        if tok == "match_line_num" { return color_hex("#0D9488", 32); }
        if tok == "match_col_num" { return color_hex("#BE123C", 31); }
        if tok == "shell_prompt" { return color_hex("#0284C7", 34); }
        if tok == "shell_builtin" { return color_hex("#0369A1", 34); }
        if tok == "shell_host_bin" { return color_hex("#4338CA", 35); }
        if tok == "shell_nav" { return color_hex("#0D9488", 32); }
        if tok == "shell_intent" { return color_hex("#7E22CE", 35); }
        if tok == "log_trace" { return color_hex("#7E9BAA", 90); }
        if tok == "log_debug" { return color_hex("#64748B", 90); }
        if tok == "log_info" { return color_hex("#0284C7", 34); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#BE123C", 31); }
    }
    return color_none();
}

pub fn theme_frost_color(tok: String, dark: Bool) -> Color {
    let c1: Color = frost_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = frost_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = frost_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return frost_shell_log_token(tok, dark);
}

pub fn theme_frost_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("frost", "openOODA", dark, "January deep winter arctic ice and glacial cyan");
}
