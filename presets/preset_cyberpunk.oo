// # Cyberpunk Preset - High-Energy Neon Aesthetic
//
// Logline: Vibrant cyberpunk theme featuring neon cyan, electric amber, ultraviolet, and toxic green.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Define cyberpunk neon swatches (Cyan, Amber, Ultraviolet, Toxic Green, Crimson).
//   2. Map UI chrome, status indicators, and diff tokens.
//   3. Map syntax, shell, and observability tokens.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn cyber_ui_token(tok: String) -> Color {
    if tok == "ui_bg" { return color_hex("#08080C", 0); }
    if tok == "ui_fg" { return color_hex("#E8F0FF", 37); }
    if tok == "ui_surface" { return color_hex("#121218", 0); }
    if tok == "ui_border" { return color_hex("#6E788C", 90); }
    if tok == "ui_border_accent" { return color_hex("#00F0FF", 36); }
    if tok == "ui_muted" { return color_hex("#6E788C", 90); }
    if tok == "ui_dim" { return color_hex("#3E4452", 90); }
    if tok == "ui_accent" { return color_hex("#00F0FF", 36); }
    return color_none();
}

fn cyber_status_diff_token(tok: String) -> Color {
    if tok == "status_success" { return color_hex("#00FF66", 32); }
    if tok == "status_warning" { return color_hex("#FFB800", 33); }
    if tok == "status_error" { return color_hex("#FF3366", 31); }
    if tok == "status_info" { return color_hex("#00AAFF", 34); }
    if tok == "diff_added" { return color_hex("#00FF66", 32); }
    if tok == "diff_removed" { return color_hex("#FF3366", 31); }
    if tok == "diff_context" { return color_hex("#6E788C", 90); }
    if tok == "diff_header" { return color_hex("#FFB800", 33); }
    return color_none();
}

fn cyber_syntax_token(tok: String) -> Color {
    if tok == "syntax_keyword" { return color_hex("#BD00FF", 35); }
    if tok == "syntax_string" { return color_hex("#00FF66", 32); }
    if tok == "syntax_number" { return color_hex("#FFB800", 33); }
    if tok == "syntax_type" { return color_hex("#00F0FF", 36); }
    if tok == "syntax_fn" { return color_hex("#00AAFF", 34); }
    if tok == "syntax_var" { return color_hex("#E8F0FF", 37); }
    if tok == "syntax_comment" { return color_hex("#6E788C", 90); }
    if tok == "syntax_op" { return color_hex("#FF3366", 31); }
    if tok == "syntax_punct" { return color_hex("#E8F0FF", 37); }
    return color_none();
}

fn cyber_shell_log_token(tok: String) -> Color {
    if tok == "match_hit" { return color_hex("#FFB800", 33); }
    if tok == "match_path" { return color_hex("#00F0FF", 36); }
    if tok == "match_line_num" { return color_hex("#00FF66", 32); }
    if tok == "match_col_num" { return color_hex("#BD00FF", 35); }
    if tok == "shell_prompt" { return color_hex("#00F0FF", 36); }
    if tok == "shell_builtin" { return color_hex("#FFB800", 33); }
    if tok == "shell_host_bin" { return color_hex("#00AAFF", 34); }
    if tok == "shell_nav" { return color_hex("#00FF66", 32); }
    if tok == "shell_intent" { return color_hex("#BD00FF", 35); }
    if tok == "log_trace" { return color_hex("#3E4452", 90); }
    if tok == "log_debug" { return color_hex("#6E788C", 90); }
    if tok == "log_info" { return color_hex("#00F0FF", 36); }
    if tok == "log_warn" { return color_hex("#FFB800", 33); }
    if tok == "log_error" { return color_hex("#FF3366", 31); }
    return color_none();
}

pub fn theme_cyberpunk_color(tok: String) -> Color {
    let c1: Color = cyber_ui_token(tok);
    if c1.is_set { return c1; }
    let c2: Color = cyber_status_diff_token(tok);
    if c2.is_set { return c2; }
    let c3: Color = cyber_syntax_token(tok);
    if c3.is_set { return c3; }
    return cyber_shell_log_token(tok);
}

pub fn theme_cyberpunk_meta() -> ThemeMeta {
    return theme_meta_new("cyberpunk", "openOODA", true, "High-energy neon cyan, ultraviolet, and toxic green");
}
