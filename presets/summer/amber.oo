// # Amber Preset - Golden Late Summer and Honey Resin
//
// Logline: August theme capturing late summer warmth, honey amber resin, and golden ripe harvest wheat.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for amber dusk and golden daylight.
//   2. Map status alerts and diff tokens with lime green, golden amber, and crimson.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn amber_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#16110A", 0); }
        if tok == "ui_fg" { return color_hex("#FEF3C7", 37); }
        if tok == "ui_surface" { return color_hex("#241C12", 0); }
        if tok == "ui_border" { return color_hex("#594324", 90); }
        if tok == "ui_border_accent" { return color_hex("#F59E0B", 33); }
        if tok == "ui_muted" { return color_hex("#B89E74", 90); }
        if tok == "ui_dim" { return color_hex("#3B2C16", 90); }
        if tok == "ui_accent" { return color_hex("#F59E0B", 33); }
    } else {
        if tok == "ui_bg" { return color_hex("#FFFBEB", 0); }
        if tok == "ui_fg" { return color_hex("#451A03", 30); }
        if tok == "ui_surface" { return color_hex("#FDE68A", 0); }
        if tok == "ui_border" { return color_hex("#FCD34D", 90); }
        if tok == "ui_border_accent" { return color_hex("#D97706", 33); }
        if tok == "ui_muted" { return color_hex("#92400E", 90); }
        if tok == "ui_dim" { return color_hex("#B45309", 90); }
        if tok == "ui_accent" { return color_hex("#D97706", 33); }
    }
    return color_none();
}

fn amber_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#84CC16", 32); }
        if tok == "status_warning" { return color_hex("#F59E0B", 33); }
        if tok == "status_error" { return color_hex("#EF4444", 31); }
        if tok == "status_info" { return color_hex("#38BDF8", 36); }
        if tok == "diff_added" { return color_hex("#84CC16", 32); }
        if tok == "diff_removed" { return color_hex("#EF4444", 31); }
        if tok == "diff_context" { return color_hex("#B89E74", 90); }
        if tok == "diff_header" { return color_hex("#F59E0B", 33); }
    } else {
        if tok == "status_success" { return color_hex("#4D7C0F", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#B91C1C", 31); }
        if tok == "status_info" { return color_hex("#0284C7", 36); }
        if tok == "diff_added" { return color_hex("#4D7C0F", 32); }
        if tok == "diff_removed" { return color_hex("#B91C1C", 31); }
        if tok == "diff_context" { return color_hex("#92400E", 90); }
        if tok == "diff_header" { return color_hex("#B45309", 33); }
    }
    return color_none();
}

fn amber_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#FBBF24", 33); }
        if tok == "syntax_string" { return color_hex("#84CC16", 32); }
        if tok == "syntax_number" { return color_hex("#FB923C", 33); }
        if tok == "syntax_type" { return color_hex("#F59E0B", 33); }
        if tok == "syntax_fn" { return color_hex("#FCD34D", 33); }
        if tok == "syntax_var" { return color_hex("#FEF3C7", 37); }
        if tok == "syntax_comment" { return color_hex("#806440", 90); }
        if tok == "syntax_op" { return color_hex("#FBBF24", 33); }
        if tok == "syntax_punct" { return color_hex("#B89E74", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#B45309", 33); }
        if tok == "syntax_string" { return color_hex("#4D7C0F", 32); }
        if tok == "syntax_number" { return color_hex("#C2410C", 33); }
        if tok == "syntax_type" { return color_hex("#D97706", 33); }
        if tok == "syntax_fn" { return color_hex("#92400E", 33); }
        if tok == "syntax_var" { return color_hex("#451A03", 30); }
        if tok == "syntax_comment" { return color_hex("#92400E", 90); }
        if tok == "syntax_op" { return color_hex("#B45309", 33); }
        if tok == "syntax_punct" { return color_hex("#92400E", 90); }
    }
    return color_none();
}

fn amber_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FBBF24", 33); }
        if tok == "match_path" { return color_hex("#F59E0B", 33); }
        if tok == "match_line_num" { return color_hex("#84CC16", 32); }
        if tok == "match_col_num" { return color_hex("#EF4444", 31); }
        if tok == "shell_prompt" { return color_hex("#F59E0B", 33); }
        if tok == "shell_builtin" { return color_hex("#FBBF24", 33); }
        if tok == "shell_host_bin" { return color_hex("#FCD34D", 33); }
        if tok == "shell_nav" { return color_hex("#84CC16", 32); }
        if tok == "shell_intent" { return color_hex("#FB923C", 33); }
        if tok == "log_trace" { return color_hex("#3B2C16", 90); }
        if tok == "log_debug" { return color_hex("#806440", 90); }
        if tok == "log_info" { return color_hex("#F59E0B", 33); }
        if tok == "log_warn" { return color_hex("#FBBF24", 33); }
        if tok == "log_error" { return color_hex("#EF4444", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#D97706", 33); }
        if tok == "match_line_num" { return color_hex("#4D7C0F", 32); }
        if tok == "match_col_num" { return color_hex("#B91C1C", 31); }
        if tok == "shell_prompt" { return color_hex("#D97706", 33); }
        if tok == "shell_builtin" { return color_hex("#B45309", 33); }
        if tok == "shell_host_bin" { return color_hex("#92400E", 33); }
        if tok == "shell_nav" { return color_hex("#4D7C0F", 32); }
        if tok == "shell_intent" { return color_hex("#C2410C", 33); }
        if tok == "log_trace" { return color_hex("#B45309", 90); }
        if tok == "log_debug" { return color_hex("#92400E", 90); }
        if tok == "log_info" { return color_hex("#D97706", 33); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#B91C1C", 31); }
    }
    return color_none();
}

pub fn theme_amber_color(tok: String, dark: Bool) -> Color {
    let c1: Color = amber_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = amber_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = amber_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return amber_shell_log_token(tok, dark);
}

pub fn theme_amber_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("amber", "openOODA", dark, "August late summer warmth honey resin and ripe wheat");
}
