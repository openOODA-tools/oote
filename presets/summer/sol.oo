// # Sol Preset - Summer Solstice Solar Flare
//
// Logline: Holiday theme celebrating Summer Solstice with solar flare radiance, corona amber, and gold.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for corona flares and solar noon daylight.
//   2. Map status alerts and diff tokens with solar emerald, amber fire, and ruby flare.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn sol_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#181208", 0); }
        if tok == "ui_fg" { return color_hex("#FEFCE8", 37); }
        if tok == "ui_surface" { return color_hex("#261C0E", 0); }
        if tok == "ui_border" { return color_hex("#594119", 90); }
        if tok == "ui_border_accent" { return color_hex("#F59E0B", 33); }
        if tok == "ui_muted" { return color_hex("#B89E6E", 90); }
        if tok == "ui_dim" { return color_hex("#3B2B11", 90); }
        if tok == "ui_accent" { return color_hex("#F59E0B", 33); }
    } else {
        if tok == "ui_bg" { return color_hex("#FEFCE8", 0); }
        if tok == "ui_fg" { return color_hex("#451A03", 30); }
        if tok == "ui_surface" { return color_hex("#FEF08A", 0); }
        if tok == "ui_border" { return color_hex("#FDE047", 90); }
        if tok == "ui_border_accent" { return color_hex("#D97706", 33); }
        if tok == "ui_muted" { return color_hex("#92400E", 90); }
        if tok == "ui_dim" { return color_hex("#B45309", 90); }
        if tok == "ui_accent" { return color_hex("#D97706", 33); }
    }
    return color_none();
}

fn sol_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#4ADE80", 32); }
        if tok == "status_warning" { return color_hex("#FCD34D", 33); }
        if tok == "status_error" { return color_hex("#EF4444", 31); }
        if tok == "status_info" { return color_hex("#F59E0B", 33); }
        if tok == "diff_added" { return color_hex("#4ADE80", 32); }
        if tok == "diff_removed" { return color_hex("#EF4444", 31); }
        if tok == "diff_context" { return color_hex("#B89E6E", 90); }
        if tok == "diff_header" { return color_hex("#F59E0B", 33); }
    } else {
        if tok == "status_success" { return color_hex("#15803D", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#B91C1C", 31); }
        if tok == "status_info" { return color_hex("#D97706", 33); }
        if tok == "diff_added" { return color_hex("#15803D", 32); }
        if tok == "diff_removed" { return color_hex("#B91C1C", 31); }
        if tok == "diff_context" { return color_hex("#92400E", 90); }
        if tok == "diff_header" { return color_hex("#B45309", 33); }
    }
    return color_none();
}

fn sol_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#FCD34D", 33); }
        if tok == "syntax_string" { return color_hex("#4ADE80", 32); }
        if tok == "syntax_number" { return color_hex("#FB923C", 33); }
        if tok == "syntax_type" { return color_hex("#F59E0B", 33); }
        if tok == "syntax_fn" { return color_hex("#FDE047", 33); }
        if tok == "syntax_var" { return color_hex("#FEFCE8", 37); }
        if tok == "syntax_comment" { return color_hex("#7D5C26", 90); }
        if tok == "syntax_op" { return color_hex("#FCD34D", 33); }
        if tok == "syntax_punct" { return color_hex("#B89E6E", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#B45309", 33); }
        if tok == "syntax_string" { return color_hex("#15803D", 32); }
        if tok == "syntax_number" { return color_hex("#C2410C", 33); }
        if tok == "syntax_type" { return color_hex("#D97706", 33); }
        if tok == "syntax_fn" { return color_hex("#92400E", 33); }
        if tok == "syntax_var" { return color_hex("#451A03", 30); }
        if tok == "syntax_comment" { return color_hex("#92400E", 90); }
        if tok == "syntax_op" { return color_hex("#B45309", 33); }
        if tok == "syntax_punct" { return color_hex("#92400E", 90); }
    }
    return color_none();
}

fn sol_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FCD34D", 33); }
        if tok == "match_path" { return color_hex("#F59E0B", 33); }
        if tok == "match_line_num" { return color_hex("#4ADE80", 32); }
        if tok == "match_col_num" { return color_hex("#EF4444", 31); }
        if tok == "shell_prompt" { return color_hex("#F59E0B", 33); }
        if tok == "shell_builtin" { return color_hex("#FCD34D", 33); }
        if tok == "shell_host_bin" { return color_hex("#FB923C", 33); }
        if tok == "shell_nav" { return color_hex("#4ADE80", 32); }
        if tok == "shell_intent" { return color_hex("#FDE047", 33); }
        if tok == "log_trace" { return color_hex("#3B2B11", 90); }
        if tok == "log_debug" { return color_hex("#7D5C26", 90); }
        if tok == "log_info" { return color_hex("#F59E0B", 33); }
        if tok == "log_warn" { return color_hex("#FCD34D", 33); }
        if tok == "log_error" { return color_hex("#EF4444", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#D97706", 33); }
        if tok == "match_line_num" { return color_hex("#15803D", 32); }
        if tok == "match_col_num" { return color_hex("#B91C1C", 31); }
        if tok == "shell_prompt" { return color_hex("#D97706", 33); }
        if tok == "shell_builtin" { return color_hex("#B45309", 33); }
        if tok == "shell_host_bin" { return color_hex("#C2410C", 33); }
        if tok == "shell_nav" { return color_hex("#15803D", 32); }
        if tok == "shell_intent" { return color_hex("#A16207", 33); }
        if tok == "log_trace" { return color_hex("#B45309", 90); }
        if tok == "log_debug" { return color_hex("#92400E", 90); }
        if tok == "log_info" { return color_hex("#D97706", 33); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#B91C1C", 31); }
    }
    return color_none();
}

pub fn theme_sol_color(tok: String, dark: Bool) -> Color {
    let c1: Color = sol_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = sol_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = sol_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return sol_shell_log_token(tok, dark);
}

pub fn theme_sol_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("sol", "openOODA", dark, "Summer Solstice celebration solar flares and corona amber");
}
