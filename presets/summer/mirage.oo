// # Mirage Preset - Desert Dunes and Turquoise Oasis
//
// Logline: July theme capturing shifting desert dunes, copper sun heat waves, and turquoise oasis shimmer.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for dune twilight and oasis daylight.
//   2. Map status alerts and diff tokens with turquoise, copper gold, and terracotta.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn mirage_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#18110D", 0); }
        if tok == "ui_fg" { return color_hex("#FFEDD5", 37); }
        if tok == "ui_surface" { return color_hex("#261C16", 0); }
        if tok == "ui_border" { return color_hex("#593D2C", 90); }
        if tok == "ui_border_accent" { return color_hex("#2DD4BF", 36); }
        if tok == "ui_muted" { return color_hex("#B89782", 90); }
        if tok == "ui_dim" { return color_hex("#3B281D", 90); }
        if tok == "ui_accent" { return color_hex("#2DD4BF", 36); }
    } else {
        if tok == "ui_bg" { return color_hex("#FFF7ED", 0); }
        if tok == "ui_fg" { return color_hex("#431407", 30); }
        if tok == "ui_surface" { return color_hex("#FED7AA", 0); }
        if tok == "ui_border" { return color_hex("#FDBA74", 90); }
        if tok == "ui_border_accent" { return color_hex("#0F766E", 36); }
        if tok == "ui_muted" { return color_hex("#9A3412", 90); }
        if tok == "ui_dim" { return color_hex("#C2410C", 90); }
        if tok == "ui_accent" { return color_hex("#0F766E", 36); }
    }
    return color_none();
}

fn mirage_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#4ADE80", 32); }
        if tok == "status_warning" { return color_hex("#FB923C", 33); }
        if tok == "status_error" { return color_hex("#F87171", 31); }
        if tok == "status_info" { return color_hex("#2DD4BF", 36); }
        if tok == "diff_added" { return color_hex("#4ADE80", 32); }
        if tok == "diff_removed" { return color_hex("#F87171", 31); }
        if tok == "diff_context" { return color_hex("#B89782", 90); }
        if tok == "diff_header" { return color_hex("#2DD4BF", 36); }
    } else {
        if tok == "status_success" { return color_hex("#16A34A", 32); }
        if tok == "status_warning" { return color_hex("#C2410C", 33); }
        if tok == "status_error" { return color_hex("#DC2626", 31); }
        if tok == "status_info" { return color_hex("#0F766E", 36); }
        if tok == "diff_added" { return color_hex("#16A34A", 32); }
        if tok == "diff_removed" { return color_hex("#DC2626", 31); }
        if tok == "diff_context" { return color_hex("#9A3412", 90); }
        if tok == "diff_header" { return color_hex("#0F766E", 36); }
    }
    return color_none();
}

fn mirage_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#38BDF8", 36); }
        if tok == "syntax_string" { return color_hex("#2DD4BF", 36); }
        if tok == "syntax_number" { return color_hex("#FB923C", 33); }
        if tok == "syntax_type" { return color_hex("#FCD34D", 33); }
        if tok == "syntax_fn" { return color_hex("#2DD4BF", 36); }
        if tok == "syntax_var" { return color_hex("#FFEDD5", 37); }
        if tok == "syntax_comment" { return color_hex("#825B42", 90); }
        if tok == "syntax_op" { return color_hex("#38BDF8", 36); }
        if tok == "syntax_punct" { return color_hex("#B89782", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#0284C7", 36); }
        if tok == "syntax_string" { return color_hex("#0F766E", 36); }
        if tok == "syntax_number" { return color_hex("#EA580C", 33); }
        if tok == "syntax_type" { return color_hex("#B45309", 33); }
        if tok == "syntax_fn" { return color_hex("#0F766E", 36); }
        if tok == "syntax_var" { return color_hex("#431407", 30); }
        if tok == "syntax_comment" { return color_hex("#9A3412", 90); }
        if tok == "syntax_op" { return color_hex("#0284C7", 36); }
        if tok == "syntax_punct" { return color_hex("#9A3412", 90); }
    }
    return color_none();
}

fn mirage_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FB923C", 33); }
        if tok == "match_path" { return color_hex("#2DD4BF", 36); }
        if tok == "match_line_num" { return color_hex("#4ADE80", 32); }
        if tok == "match_col_num" { return color_hex("#F87171", 31); }
        if tok == "shell_prompt" { return color_hex("#2DD4BF", 36); }
        if tok == "shell_builtin" { return color_hex("#38BDF8", 36); }
        if tok == "shell_host_bin" { return color_hex("#FCD34D", 33); }
        if tok == "shell_nav" { return color_hex("#4ADE80", 32); }
        if tok == "shell_intent" { return color_hex("#FB923C", 33); }
        if tok == "log_trace" { return color_hex("#3B281D", 90); }
        if tok == "log_debug" { return color_hex("#825B42", 90); }
        if tok == "log_info" { return color_hex("#2DD4BF", 36); }
        if tok == "log_warn" { return color_hex("#FB923C", 33); }
        if tok == "log_error" { return color_hex("#F87171", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#EA580C", 33); }
        if tok == "match_path" { return color_hex("#0F766E", 36); }
        if tok == "match_line_num" { return color_hex("#16A34A", 32); }
        if tok == "match_col_num" { return color_hex("#DC2626", 31); }
        if tok == "shell_prompt" { return color_hex("#0F766E", 36); }
        if tok == "shell_builtin" { return color_hex("#0284C7", 36); }
        if tok == "shell_host_bin" { return color_hex("#B45309", 33); }
        if tok == "shell_nav" { return color_hex("#16A34A", 32); }
        if tok == "shell_intent" { return color_hex("#EA580C", 33); }
        if tok == "log_trace" { return color_hex("#C2410C", 90); }
        if tok == "log_debug" { return color_hex("#9A3412", 90); }
        if tok == "log_info" { return color_hex("#0F766E", 36); }
        if tok == "log_warn" { return color_hex("#EA580C", 33); }
        if tok == "log_error" { return color_hex("#DC2626", 31); }
    }
    return color_none();
}

pub fn theme_mirage_color(tok: String, dark: Bool) -> Color {
    let c1: Color = mirage_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = mirage_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = mirage_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return mirage_shell_log_token(tok, dark);
}

pub fn theme_mirage_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("mirage", "openOODA", dark, "July desert dunes with turquoise oasis and copper sun");
}
