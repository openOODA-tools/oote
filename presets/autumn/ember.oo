// # Ember Preset - Campfire Embers and Autumn Foliage
//
// Logline: October theme capturing glowing fire embers, crisp autumn leaves, and smoky charcoal darkness.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for ember night and warm hearth daylight.
//   2. Map status alerts and diff tokens with flame orange, forest green, and ember red.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn ember_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#170D08", 0); }
        if tok == "ui_fg" { return color_hex("#FFEDD5", 37); }
        if tok == "ui_surface" { return color_hex("#251710", 0); }
        if tok == "ui_border" { return color_hex("#5C3620", 90); }
        if tok == "ui_border_accent" { return color_hex("#FB923C", 33); }
        if tok == "ui_muted" { return color_hex("#B8947E", 90); }
        if tok == "ui_dim" { return color_hex("#3D2415", 90); }
        if tok == "ui_accent" { return color_hex("#FB923C", 33); }
    } else {
        if tok == "ui_bg" { return color_hex("#FFF7ED", 0); }
        if tok == "ui_fg" { return color_hex("#431407", 30); }
        if tok == "ui_surface" { return color_hex("#FFEDD5", 0); }
        if tok == "ui_border" { return color_hex("#FDBA74", 90); }
        if tok == "ui_border_accent" { return color_hex("#EA580C", 33); }
        if tok == "ui_muted" { return color_hex("#9A3412", 90); }
        if tok == "ui_dim" { return color_hex("#C2410C", 90); }
        if tok == "ui_accent" { return color_hex("#EA580C", 33); }
    }
    return color_none();
}

fn ember_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#4ADE80", 32); }
        if tok == "status_warning" { return color_hex("#FBBF24", 33); }
        if tok == "status_error" { return color_hex("#F87171", 31); }
        if tok == "status_info" { return color_hex("#FB923C", 33); }
        if tok == "diff_added" { return color_hex("#4ADE80", 32); }
        if tok == "diff_removed" { return color_hex("#F87171", 31); }
        if tok == "diff_context" { return color_hex("#B8947E", 90); }
        if tok == "diff_header" { return color_hex("#FB923C", 33); }
    } else {
        if tok == "status_success" { return color_hex("#16A34A", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#DC2626", 31); }
        if tok == "status_info" { return color_hex("#EA580C", 33); }
        if tok == "diff_added" { return color_hex("#16A34A", 32); }
        if tok == "diff_removed" { return color_hex("#DC2626", 31); }
        if tok == "diff_context" { return color_hex("#9A3412", 90); }
        if tok == "diff_header" { return color_hex("#EA580C", 33); }
    }
    return color_none();
}

fn ember_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#F97316", 33); }
        if tok == "syntax_string" { return color_hex("#4ADE80", 32); }
        if tok == "syntax_number" { return color_hex("#FBBF24", 33); }
        if tok == "syntax_type" { return color_hex("#FB923C", 33); }
        if tok == "syntax_fn" { return color_hex("#FCD34D", 33); }
        if tok == "syntax_var" { return color_hex("#FFEDD5", 37); }
        if tok == "syntax_comment" { return color_hex("#8C5838", 90); }
        if tok == "syntax_op" { return color_hex("#F97316", 33); }
        if tok == "syntax_punct" { return color_hex("#B8947E", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#C2410C", 33); }
        if tok == "syntax_string" { return color_hex("#16A34A", 32); }
        if tok == "syntax_number" { return color_hex("#B45309", 33); }
        if tok == "syntax_type" { return color_hex("#EA580C", 33); }
        if tok == "syntax_fn" { return color_hex("#9A3412", 33); }
        if tok == "syntax_var" { return color_hex("#431407", 30); }
        if tok == "syntax_comment" { return color_hex("#9A3412", 90); }
        if tok == "syntax_op" { return color_hex("#C2410C", 33); }
        if tok == "syntax_punct" { return color_hex("#9A3412", 90); }
    }
    return color_none();
}

fn ember_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FBBF24", 33); }
        if tok == "match_path" { return color_hex("#FB923C", 33); }
        if tok == "match_line_num" { return color_hex("#4ADE80", 32); }
        if tok == "match_col_num" { return color_hex("#F87171", 31); }
        if tok == "shell_prompt" { return color_hex("#FB923C", 33); }
        if tok == "shell_builtin" { return color_hex("#F97316", 33); }
        if tok == "shell_host_bin" { return color_hex("#FBBF24", 33); }
        if tok == "shell_nav" { return color_hex("#4ADE80", 32); }
        if tok == "shell_intent" { return color_hex("#FCD34D", 33); }
        if tok == "log_trace" { return color_hex("#3D2415", 90); }
        if tok == "log_debug" { return color_hex("#8C5838", 90); }
        if tok == "log_info" { return color_hex("#FB923C", 33); }
        if tok == "log_warn" { return color_hex("#FBBF24", 33); }
        if tok == "log_error" { return color_hex("#F87171", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#EA580C", 33); }
        if tok == "match_line_num" { return color_hex("#16A34A", 32); }
        if tok == "match_col_num" { return color_hex("#DC2626", 31); }
        if tok == "shell_prompt" { return color_hex("#EA580C", 33); }
        if tok == "shell_builtin" { return color_hex("#C2410C", 33); }
        if tok == "shell_host_bin" { return color_hex("#9A3412", 33); }
        if tok == "shell_nav" { return color_hex("#16A34A", 32); }
        if tok == "shell_intent" { return color_hex("#B45309", 33); }
        if tok == "log_trace" { return color_hex("#C2410C", 90); }
        if tok == "log_debug" { return color_hex("#9A3412", 90); }
        if tok == "log_info" { return color_hex("#EA580C", 33); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#DC2626", 31); }
    }
    return color_none();
}

pub fn theme_ember_color(tok: String, dark: Bool) -> Color {
    let c1: Color = ember_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = ember_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = ember_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return ember_shell_log_token(tok, dark);
}

pub fn theme_ember_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("ember", "openOODA", dark, "October campfire embers autumn foliage and smoky charcoal");
}
