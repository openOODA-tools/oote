// # Equinox Preset - Autumn Equilibrium and Golden Hour
//
// Logline: September theme capturing autumn balance, twilight indigo, and golden hour ochre.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for equinox twilight and golden hour light.
//   2. Map status alerts and diff tokens with balance teal, ochre gold, and rustic ruby.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn equinox_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#10141D", 0); }
        if tok == "ui_fg" { return color_hex("#EAEFF8", 37); }
        if tok == "ui_surface" { return color_hex("#1B202D", 0); }
        if tok == "ui_border" { return color_hex("#3A4760", 90); }
        if tok == "ui_border_accent" { return color_hex("#E2B340", 33); }
        if tok == "ui_muted" { return color_hex("#8E9DB8", 90); }
        if tok == "ui_dim" { return color_hex("#252E40", 90); }
        if tok == "ui_accent" { return color_hex("#E2B340", 33); }
    } else {
        if tok == "ui_bg" { return color_hex("#F4F6FB", 0); }
        if tok == "ui_fg" { return color_hex("#1A2234", 30); }
        if tok == "ui_surface" { return color_hex("#E4E9F5", 0); }
        if tok == "ui_border" { return color_hex("#BAC5DF", 90); }
        if tok == "ui_border_accent" { return color_hex("#B45309", 33); }
        if tok == "ui_muted" { return color_hex("#475569", 90); }
        if tok == "ui_dim" { return color_hex("#7B8CA8", 90); }
        if tok == "ui_accent" { return color_hex("#B45309", 33); }
    }
    return color_none();
}

fn equinox_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#4ED8A3", 32); }
        if tok == "status_warning" { return color_hex("#E2B340", 33); }
        if tok == "status_error" { return color_hex("#F87171", 31); }
        if tok == "status_info" { return color_hex("#818CF8", 34); }
        if tok == "diff_added" { return color_hex("#4ED8A3", 32); }
        if tok == "diff_removed" { return color_hex("#F87171", 31); }
        if tok == "diff_context" { return color_hex("#8E9DB8", 90); }
        if tok == "diff_header" { return color_hex("#E2B340", 33); }
    } else {
        if tok == "status_success" { return color_hex("#0D9488", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#BE123C", 31); }
        if tok == "status_info" { return color_hex("#4338CA", 34); }
        if tok == "diff_added" { return color_hex("#0D9488", 32); }
        if tok == "diff_removed" { return color_hex("#BE123C", 31); }
        if tok == "diff_context" { return color_hex("#475569", 90); }
        if tok == "diff_header" { return color_hex("#B45309", 33); }
    }
    return color_none();
}

fn equinox_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#818CF8", 34); }
        if tok == "syntax_string" { return color_hex("#4ED8A3", 32); }
        if tok == "syntax_number" { return color_hex("#E2B340", 33); }
        if tok == "syntax_type" { return color_hex("#38BDF8", 36); }
        if tok == "syntax_fn" { return color_hex("#A5B4FC", 34); }
        if tok == "syntax_var" { return color_hex("#EAEFF8", 37); }
        if tok == "syntax_comment" { return color_hex("#586B8C", 90); }
        if tok == "syntax_op" { return color_hex("#E2B340", 33); }
        if tok == "syntax_punct" { return color_hex("#8E9DB8", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#4338CA", 34); }
        if tok == "syntax_string" { return color_hex("#0D9488", 32); }
        if tok == "syntax_number" { return color_hex("#B45309", 33); }
        if tok == "syntax_type" { return color_hex("#0284C7", 36); }
        if tok == "syntax_fn" { return color_hex("#3730A3", 34); }
        if tok == "syntax_var" { return color_hex("#1A2234", 30); }
        if tok == "syntax_comment" { return color_hex("#64748B", 90); }
        if tok == "syntax_op" { return color_hex("#B45309", 33); }
        if tok == "syntax_punct" { return color_hex("#475569", 90); }
    }
    return color_none();
}

fn equinox_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#E2B340", 33); }
        if tok == "match_path" { return color_hex("#818CF8", 34); }
        if tok == "match_line_num" { return color_hex("#4ED8A3", 32); }
        if tok == "match_col_num" { return color_hex("#F87171", 31); }
        if tok == "shell_prompt" { return color_hex("#E2B340", 33); }
        if tok == "shell_builtin" { return color_hex("#818CF8", 34); }
        if tok == "shell_host_bin" { return color_hex("#38BDF8", 36); }
        if tok == "shell_nav" { return color_hex("#4ED8A3", 32); }
        if tok == "shell_intent" { return color_hex("#C084FC", 35); }
        if tok == "log_trace" { return color_hex("#252E40", 90); }
        if tok == "log_debug" { return color_hex("#586B8C", 90); }
        if tok == "log_info" { return color_hex("#818CF8", 34); }
        if tok == "log_warn" { return color_hex("#E2B340", 33); }
        if tok == "log_error" { return color_hex("#F87171", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#4338CA", 34); }
        if tok == "match_line_num" { return color_hex("#0D9488", 32); }
        if tok == "match_col_num" { return color_hex("#BE123C", 31); }
        if tok == "shell_prompt" { return color_hex("#B45309", 33); }
        if tok == "shell_builtin" { return color_hex("#4338CA", 34); }
        if tok == "shell_host_bin" { return color_hex("#0284C7", 36); }
        if tok == "shell_nav" { return color_hex("#0D9488", 32); }
        if tok == "shell_intent" { return color_hex("#7E22CE", 35); }
        if tok == "log_trace" { return color_hex("#7B8CA8", 90); }
        if tok == "log_debug" { return color_hex("#64748B", 90); }
        if tok == "log_info" { return color_hex("#4338CA", 34); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#BE123C", 31); }
    }
    return color_none();
}

pub fn theme_equinox_color(tok: String, dark: Bool) -> Color {
    let c1: Color = equinox_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = equinox_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = equinox_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return equinox_shell_log_token(tok, dark);
}

pub fn theme_equinox_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("equinox", "openOODA", dark, "September autumn equilibrium twilight indigo and ochre");
}
