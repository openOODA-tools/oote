// # Bloom Preset - Spring Blossom and Floral Renewal
//
// Logline: April theme capturing blossoming orchards, pastel pinks, fresh dew, and floral revival.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for blossom twilight and floral daylight.
//   2. Map status alerts and diff tokens with petal rose, mint green, and amber.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn bloom_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#170F14", 0); }
        if tok == "ui_fg" { return color_hex("#FCE7F3", 37); }
        if tok == "ui_surface" { return color_hex("#241820", 0); }
        if tok == "ui_border" { return color_hex("#59334A", 90); }
        if tok == "ui_border_accent" { return color_hex("#F472B6", 35); }
        if tok == "ui_muted" { return color_hex("#A87A96", 90); }
        if tok == "ui_dim" { return color_hex("#3B2232", 90); }
        if tok == "ui_accent" { return color_hex("#F472B6", 35); }
    } else {
        if tok == "ui_bg" { return color_hex("#FDF2F8", 0); }
        if tok == "ui_fg" { return color_hex("#3B1124", 30); }
        if tok == "ui_surface" { return color_hex("#FCE7F3", 0); }
        if tok == "ui_border" { return color_hex("#F472B6", 90); }
        if tok == "ui_border_accent" { return color_hex("#DB2777", 35); }
        if tok == "ui_muted" { return color_hex("#831843", 90); }
        if tok == "ui_dim" { return color_hex("#BE185D", 90); }
        if tok == "ui_accent" { return color_hex("#DB2777", 35); }
    }
    return color_none();
}

fn bloom_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#86EFAC", 32); }
        if tok == "status_warning" { return color_hex("#FDE047", 33); }
        if tok == "status_error" { return color_hex("#FB7185", 31); }
        if tok == "status_info" { return color_hex("#38BDF8", 36); }
        if tok == "diff_added" { return color_hex("#86EFAC", 32); }
        if tok == "diff_removed" { return color_hex("#FB7185", 31); }
        if tok == "diff_context" { return color_hex("#A87A96", 90); }
        if tok == "diff_header" { return color_hex("#F472B6", 35); }
    } else {
        if tok == "status_success" { return color_hex("#16A34A", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#BE123C", 31); }
        if tok == "status_info" { return color_hex("#0284C7", 36); }
        if tok == "diff_added" { return color_hex("#16A34A", 32); }
        if tok == "diff_removed" { return color_hex("#BE123C", 31); }
        if tok == "diff_context" { return color_hex("#831843", 90); }
        if tok == "diff_header" { return color_hex("#DB2777", 35); }
    }
    return color_none();
}

fn bloom_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#F472B6", 35); }
        if tok == "syntax_string" { return color_hex("#86EFAC", 32); }
        if tok == "syntax_number" { return color_hex("#FDE047", 33); }
        if tok == "syntax_type" { return color_hex("#C084FC", 35); }
        if tok == "syntax_fn" { return color_hex("#FB7185", 31); }
        if tok == "syntax_var" { return color_hex("#FCE7F3", 37); }
        if tok == "syntax_comment" { return color_hex("#784C66", 90); }
        if tok == "syntax_op" { return color_hex("#F472B6", 35); }
        if tok == "syntax_punct" { return color_hex("#A87A96", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#BE185D", 35); }
        if tok == "syntax_string" { return color_hex("#16A34A", 32); }
        if tok == "syntax_number" { return color_hex("#B45309", 33); }
        if tok == "syntax_type" { return color_hex("#7E22CE", 35); }
        if tok == "syntax_fn" { return color_hex("#DB2777", 35); }
        if tok == "syntax_var" { return color_hex("#3B1124", 30); }
        if tok == "syntax_comment" { return color_hex("#831843", 90); }
        if tok == "syntax_op" { return color_hex("#BE185D", 35); }
        if tok == "syntax_punct" { return color_hex("#831843", 90); }
    }
    return color_none();
}

fn bloom_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FDE047", 33); }
        if tok == "match_path" { return color_hex("#C084FC", 35); }
        if tok == "match_line_num" { return color_hex("#86EFAC", 32); }
        if tok == "match_col_num" { return color_hex("#FB7185", 31); }
        if tok == "shell_prompt" { return color_hex("#F472B6", 35); }
        if tok == "shell_builtin" { return color_hex("#FB7185", 31); }
        if tok == "shell_host_bin" { return color_hex("#C084FC", 35); }
        if tok == "shell_nav" { return color_hex("#86EFAC", 32); }
        if tok == "shell_intent" { return color_hex("#38BDF8", 36); }
        if tok == "log_trace" { return color_hex("#3B2232", 90); }
        if tok == "log_debug" { return color_hex("#784C66", 90); }
        if tok == "log_info" { return color_hex("#38BDF8", 36); }
        if tok == "log_warn" { return color_hex("#FDE047", 33); }
        if tok == "log_error" { return color_hex("#FB7185", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#B45309", 33); }
        if tok == "match_path" { return color_hex("#7E22CE", 35); }
        if tok == "match_line_num" { return color_hex("#16A34A", 32); }
        if tok == "match_col_num" { return color_hex("#BE123C", 31); }
        if tok == "shell_prompt" { return color_hex("#DB2777", 35); }
        if tok == "shell_builtin" { return color_hex("#BE185D", 35); }
        if tok == "shell_host_bin" { return color_hex("#7E22CE", 35); }
        if tok == "shell_nav" { return color_hex("#16A34A", 32); }
        if tok == "shell_intent" { return color_hex("#0284C7", 36); }
        if tok == "log_trace" { return color_hex("#BE185D", 90); }
        if tok == "log_debug" { return color_hex("#831843", 90); }
        if tok == "log_info" { return color_hex("#0284C7", 36); }
        if tok == "log_warn" { return color_hex("#B45309", 33); }
        if tok == "log_error" { return color_hex("#BE123C", 31); }
    }
    return color_none();
}

pub fn theme_bloom_color(tok: String, dark: Bool) -> Color {
    let c1: Color = bloom_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = bloom_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = bloom_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return bloom_shell_log_token(tok, dark);
}

pub fn theme_bloom_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("bloom", "openOODA", dark, "April blossoming orchards with pastel pinks and dew");
}
