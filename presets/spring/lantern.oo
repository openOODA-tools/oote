// # Lantern Preset - Lunar New Year Scarlet and Festive Gold
//
// Logline: Holiday theme honoring Lunar New Year with imperial scarlet, auspicious gold foil, and midnight noir.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for lantern festivals and celebration daylight.
//   2. Map status alerts and diff tokens with jade green, gold foil, and imperial red.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn lantern_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#180808", 0); }
        if tok == "ui_fg" { return color_hex("#FEF2F2", 37); }
        if tok == "ui_surface" { return color_hex("#261010", 0); }
        if tok == "ui_border" { return color_hex("#5C2020", 90); }
        if tok == "ui_border_accent" { return color_hex("#EF4444", 31); }
        if tok == "ui_muted" { return color_hex("#B88686", 90); }
        if tok == "ui_dim" { return color_hex("#3D1616", 90); }
        if tok == "ui_accent" { return color_hex("#EF4444", 31); }
    } else {
        if tok == "ui_bg" { return color_hex("#FEF2F2", 0); }
        if tok == "ui_fg" { return color_hex("#450A0A", 30); }
        if tok == "ui_surface" { return color_hex("#FEE2E2", 0); }
        if tok == "ui_border" { return color_hex("#FCA5A5", 90); }
        if tok == "ui_border_accent" { return color_hex("#DC2626", 31); }
        if tok == "ui_muted" { return color_hex("#7F1D1D", 90); }
        if tok == "ui_dim" { return color_hex("#B91C1C", 90); }
        if tok == "ui_accent" { return color_hex("#DC2626", 31); }
    }
    return color_none();
}

fn lantern_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#34D399", 32); }
        if tok == "status_warning" { return color_hex("#FBBF24", 33); }
        if tok == "status_error" { return color_hex("#EF4444", 31); }
        if tok == "status_info" { return color_hex("#FCD34D", 33); }
        if tok == "diff_added" { return color_hex("#34D399", 32); }
        if tok == "diff_removed" { return color_hex("#EF4444", 31); }
        if tok == "diff_context" { return color_hex("#B88686", 90); }
        if tok == "diff_header" { return color_hex("#FBBF24", 33); }
    } else {
        if tok == "status_success" { return color_hex("#15803D", 32); }
        if tok == "status_warning" { return color_hex("#B45309", 33); }
        if tok == "status_error" { return color_hex("#B91C1C", 31); }
        if tok == "status_info" { return color_hex("#A16207", 33); }
        if tok == "diff_added" { return color_hex("#15803D", 32); }
        if tok == "diff_removed" { return color_hex("#B91C1C", 31); }
        if tok == "diff_context" { return color_hex("#7F1D1D", 90); }
        if tok == "diff_header" { return color_hex("#B45309", 33); }
    }
    return color_none();
}

fn lantern_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#F87171", 31); }
        if tok == "syntax_string" { return color_hex("#FBBF24", 33); }
        if tok == "syntax_number" { return color_hex("#FCD34D", 33); }
        if tok == "syntax_type" { return color_hex("#FCA5A5", 31); }
        if tok == "syntax_fn" { return color_hex("#FDE047", 33); }
        if tok == "syntax_var" { return color_hex("#FEF2F2", 37); }
        if tok == "syntax_comment" { return color_hex("#7F4040", 90); }
        if tok == "syntax_op" { return color_hex("#F87171", 31); }
        if tok == "syntax_punct" { return color_hex("#B88686", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#B91C1C", 31); }
        if tok == "syntax_string" { return color_hex("#B45309", 33); }
        if tok == "syntax_number" { return color_hex("#854D0E", 33); }
        if tok == "syntax_type" { return color_hex("#991B1B", 31); }
        if tok == "syntax_fn" { return color_hex("#A16207", 33); }
        if tok == "syntax_var" { return color_hex("#450A0A", 30); }
        if tok == "syntax_comment" { return color_hex("#7F1D1D", 90); }
        if tok == "syntax_op" { return color_hex("#B91C1C", 31); }
        if tok == "syntax_punct" { return color_hex("#7F1D1D", 90); }
    }
    return color_none();
}

fn lantern_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FDE047", 33); }
        if tok == "match_path" { return color_hex("#FBBF24", 33); }
        if tok == "match_line_num" { return color_hex("#34D399", 32); }
        if tok == "match_col_num" { return color_hex("#EF4444", 31); }
        if tok == "shell_prompt" { return color_hex("#EF4444", 31); }
        if tok == "shell_builtin" { return color_hex("#FBBF24", 33); }
        if tok == "shell_host_bin" { return color_hex("#FCA5A5", 31); }
        if tok == "shell_nav" { return color_hex("#34D399", 32); }
        if tok == "shell_intent" { return color_hex("#FDE047", 33); }
        if tok == "log_trace" { return color_hex("#3D1616", 90); }
        if tok == "log_debug" { return color_hex("#7F4040", 90); }
        if tok == "log_info" { return color_hex("#FBBF24", 33); }
        if tok == "log_warn" { return color_hex("#FDE047", 33); }
        if tok == "log_error" { return color_hex("#EF4444", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#A16207", 33); }
        if tok == "match_path" { return color_hex("#B45309", 33); }
        if tok == "match_line_num" { return color_hex("#15803D", 32); }
        if tok == "match_col_num" { return color_hex("#B91C1C", 31); }
        if tok == "shell_prompt" { return color_hex("#DC2626", 31); }
        if tok == "shell_builtin" { return color_hex("#B45309", 33); }
        if tok == "shell_host_bin" { return color_hex("#991B1B", 31); }
        if tok == "shell_nav" { return color_hex("#15803D", 32); }
        if tok == "shell_intent" { return color_hex("#A16207", 33); }
        if tok == "log_trace" { return color_hex("#B91C1C", 90); }
        if tok == "log_debug" { return color_hex("#7F1D1D", 90); }
        if tok == "log_info" { return color_hex("#B45309", 33); }
        if tok == "log_warn" { return color_hex("#A16207", 33); }
        if tok == "log_error" { return color_hex("#B91C1C", 31); }
    }
    return color_none();
}

pub fn theme_lantern_color(tok: String, dark: Bool) -> Color {
    let c1: Color = lantern_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = lantern_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = lantern_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return lantern_shell_log_token(tok, dark);
}

pub fn theme_lantern_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("lantern", "openOODA", dark, "Lunar New Year celebration imperial scarlet and gold");
}
