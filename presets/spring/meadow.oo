// # Meadow Preset - Lush Emerald Pasture and Clover
//
// Logline: May theme capturing open emerald meadows, clover carpets, and vibrant sunlight through green leaves.
//
// Setup: Pure color mappings. Relies on spec/color_model.oo and spec/theme_model.oo.
//
// Beats:
//   1. Map UI chrome, canvas backgrounds, and borders for meadow dusk and sunny clover light.
//   2. Map status alerts and diff tokens with clover green, dandelion gold, and poppy red.
//   3. Map syntax tokens, shell navigation, and logging levels.
//   4. Expose unified token color resolver and theme metadata.

import "spec/color_model.oo";
import "spec/theme_model.oo";

fn meadow_ui_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "ui_bg" { return color_hex("#0C160F", 0); }
        if tok == "ui_fg" { return color_hex("#DCFCE7", 37); }
        if tok == "ui_surface" { return color_hex("#15241A", 0); }
        if tok == "ui_border" { return color_hex("#265233", 90); }
        if tok == "ui_border_accent" { return color_hex("#4ADE80", 32); }
        if tok == "ui_muted" { return color_hex("#7BB88D", 90); }
        if tok == "ui_dim" { return color_hex("#1B3B24", 90); }
        if tok == "ui_accent" { return color_hex("#4ADE80", 32); }
    } else {
        if tok == "ui_bg" { return color_hex("#F0FDF4", 0); }
        if tok == "ui_fg" { return color_hex("#14381C", 30); }
        if tok == "ui_surface" { return color_hex("#DCFCE7", 0); }
        if tok == "ui_border" { return color_hex("#86EFAC", 90); }
        if tok == "ui_border_accent" { return color_hex("#16A34A", 32); }
        if tok == "ui_muted" { return color_hex("#2F6E3E", 90); }
        if tok == "ui_dim" { return color_hex("#58A86C", 90); }
        if tok == "ui_accent" { return color_hex("#16A34A", 32); }
    }
    return color_none();
}

fn meadow_status_diff_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "status_success" { return color_hex("#4ADE80", 32); }
        if tok == "status_warning" { return color_hex("#FACC15", 33); }
        if tok == "status_error" { return color_hex("#F87171", 31); }
        if tok == "status_info" { return color_hex("#38BDF8", 36); }
        if tok == "diff_added" { return color_hex("#4ADE80", 32); }
        if tok == "diff_removed" { return color_hex("#F87171", 31); }
        if tok == "diff_context" { return color_hex("#7BB88D", 90); }
        if tok == "diff_header" { return color_hex("#FACC15", 33); }
    } else {
        if tok == "status_success" { return color_hex("#15803D", 32); }
        if tok == "status_warning" { return color_hex("#A16207", 33); }
        if tok == "status_error" { return color_hex("#DC2626", 31); }
        if tok == "status_info" { return color_hex("#0284C7", 36); }
        if tok == "diff_added" { return color_hex("#15803D", 32); }
        if tok == "diff_removed" { return color_hex("#DC2626", 31); }
        if tok == "diff_context" { return color_hex("#2F6E3E", 90); }
        if tok == "diff_header" { return color_hex("#A16207", 33); }
    }
    return color_none();
}

fn meadow_syntax_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "syntax_keyword" { return color_hex("#A3E635", 32); }
        if tok == "syntax_string" { return color_hex("#4ADE80", 32); }
        if tok == "syntax_number" { return color_hex("#FACC15", 33); }
        if tok == "syntax_type" { return color_hex("#2DD4BF", 36); }
        if tok == "syntax_fn" { return color_hex("#86EFAC", 32); }
        if tok == "syntax_var" { return color_hex("#DCFCE7", 37); }
        if tok == "syntax_comment" { return color_hex("#4E805B", 90); }
        if tok == "syntax_op" { return color_hex("#A3E635", 32); }
        if tok == "syntax_punct" { return color_hex("#7BB88D", 90); }
    } else {
        if tok == "syntax_keyword" { return color_hex("#4D7C0F", 32); }
        if tok == "syntax_string" { return color_hex("#15803D", 32); }
        if tok == "syntax_number" { return color_hex("#A16207", 33); }
        if tok == "syntax_type" { return color_hex("#0F766E", 36); }
        if tok == "syntax_fn" { return color_hex("#16A34A", 32); }
        if tok == "syntax_var" { return color_hex("#14381C", 30); }
        if tok == "syntax_comment" { return color_hex("#2F6E3E", 90); }
        if tok == "syntax_op" { return color_hex("#4D7C0F", 32); }
        if tok == "syntax_punct" { return color_hex("#2F6E3E", 90); }
    }
    return color_none();
}

fn meadow_shell_log_token(tok: String, dark: Bool) -> Color {
    if dark {
        if tok == "match_hit" { return color_hex("#FACC15", 33); }
        if tok == "match_path" { return color_hex("#2DD4BF", 36); }
        if tok == "match_line_num" { return color_hex("#4ADE80", 32); }
        if tok == "match_col_num" { return color_hex("#F87171", 31); }
        if tok == "shell_prompt" { return color_hex("#4ADE80", 32); }
        if tok == "shell_builtin" { return color_hex("#A3E635", 32); }
        if tok == "shell_host_bin" { return color_hex("#2DD4BF", 36); }
        if tok == "shell_nav" { return color_hex("#86EFAC", 32); }
        if tok == "shell_intent" { return color_hex("#C084FC", 35); }
        if tok == "log_trace" { return color_hex("#1B3B24", 90); }
        if tok == "log_debug" { return color_hex("#4E805B", 90); }
        if tok == "log_info" { return color_hex("#2DD4BF", 36); }
        if tok == "log_warn" { return color_hex("#FACC15", 33); }
        if tok == "log_error" { return color_hex("#F87171", 31); }
    } else {
        if tok == "match_hit" { return color_hex("#A16207", 33); }
        if tok == "match_path" { return color_hex("#0F766E", 36); }
        if tok == "match_line_num" { return color_hex("#15803D", 32); }
        if tok == "match_col_num" { return color_hex("#DC2626", 31); }
        if tok == "shell_prompt" { return color_hex("#16A34A", 32); }
        if tok == "shell_builtin" { return color_hex("#4D7C0F", 32); }
        if tok == "shell_host_bin" { return color_hex("#0F766E", 36); }
        if tok == "shell_nav" { return color_hex("#15803D", 32); }
        if tok == "shell_intent" { return color_hex("#7E22CE", 35); }
        if tok == "log_trace" { return color_hex("#58A86C", 90); }
        if tok == "log_debug" { return color_hex("#2F6E3E", 90); }
        if tok == "log_info" { return color_hex("#0F766E", 36); }
        if tok == "log_warn" { return color_hex("#A16207", 33); }
        if tok == "log_error" { return color_hex("#DC2626", 31); }
    }
    return color_none();
}

pub fn theme_meadow_color(tok: String, dark: Bool) -> Color {
    let c1: Color = meadow_ui_token(tok, dark);
    if c1.is_set { return c1; }
    let c2: Color = meadow_status_diff_token(tok, dark);
    if c2.is_set { return c2; }
    let c3: Color = meadow_syntax_token(tok, dark);
    if c3.is_set { return c3; }
    return meadow_shell_log_token(tok, dark);
}

pub fn theme_meadow_meta(dark: Bool) -> ThemeMeta {
    return theme_meta_new("meadow", "openOODA", dark, "May emerald clover fields and fresh spring sunlight");
}
