// # Preview Card - Terminal Theme Showcase
//
// Logline: Renders an interactive terminal showcase displaying theme swatches, mascots, diffs, and syntax.
//
// Setup: Pure string assembly. Queries preset registry, border frames, and mascot models.
//
// Beats:
//   1. Render header with theme metadata, border shape, and lighting status.
//   2. Render signature ASCII mascot art and micro prompt glyph.
//   3. Render color swatches, simulated diffs, syntax highlights, and shell prompt.
//   4. Assemble into a structured framed terminal showcase card.

import "painter.oo";
import "border.oo";
import "spec/color_model.oo";
import "spec/theme_model.oo";
import "presets/preset_registry.oo";
import "mascot/mascot_model.oo";
import "mascot/mascot_registry.oo";

fn preview_header(theme_name: String, meta: ThemeMeta, border_shape: String, color_on: Bool, tc_on: Bool) -> String {
    let accent: Color = theme_get_color_mode(theme_name, "ui_accent", meta.dark);
    let title: String = paint_bold("══ " + meta.name + " ══", accent, color_on, tc_on);
    let mode_tag: String = if meta.dark { "[DARK]" } else { "[LIGHT]" };
    let desc: String = " (" + meta.description + ") " + mode_tag;
    let top: String = border_top_bar(64, title, border_shape) + "\n";
    let sub: String = border_wrap_line(desc, 62, border_shape) + "\n";
    return top + sub;
}

fn preview_mascot(theme_name: String, border_shape: String, color_on: Bool, tc_on: Bool, dark: Bool) -> String {
    let accent: Color = theme_get_color_mode(theme_name, "ui_accent", dark);
    let m: Mascot = mascot_get(theme_name, "happy");
    let g: String = mascot_glyph(theme_name, "idle");
    let label: String = "Mascot: " + m.name + " " + g;
    let l1: String = border_wrap_line(paint_bold(m.line1, accent, color_on, tc_on), 62, border_shape);
    let l2: String = border_wrap_line(paint_bold(m.line2, accent, color_on, tc_on), 62, border_shape);
    let l3: String = border_wrap_line(paint_bold(m.line3, accent, color_on, tc_on), 62, border_shape);
    let head: String = border_wrap_line(label, 62, border_shape);
    return head + "\n" + l1 + "\n" + l2 + "\n" + l3 + "\n";
}

fn preview_swatches(theme_name: String, border_shape: String, color_on: Bool, tc_on: Bool, dark: Bool) -> String {
    let c_acc: Color = theme_get_color_mode(theme_name, "ui_accent", dark);
    let c_suc: Color = theme_get_color_mode(theme_name, "status_success", dark);
    let c_wrn: Color = theme_get_color_mode(theme_name, "status_warning", dark);
    let c_err: Color = theme_get_color_mode(theme_name, "status_error", dark);
    let c_inf: Color = theme_get_color_mode(theme_name, "status_info", dark);

    let b_acc: String = paint_bold("[ACC]", c_acc, color_on, tc_on);
    let b_suc: String = paint_bold("[OK]", c_suc, color_on, tc_on);
    let b_wrn: String = paint_bold("[WARN]", c_wrn, color_on, tc_on);
    let b_err: String = paint_bold("[ERR]", c_err, color_on, tc_on);
    let b_inf: String = paint_bold("[INFO]", c_inf, color_on, tc_on);
    let row: String = "Swatches: " + b_acc + " " + b_suc + " " + b_wrn + " " + b_err + " " + b_inf;
    return border_wrap_line(row, 62, border_shape) + "\n";
}

fn preview_diff(theme_name: String, border_shape: String, color_on: Bool, tc_on: Bool, dark: Bool) -> String {
    let c_hdr: Color = theme_get_color_mode(theme_name, "diff_header", dark);
    let c_add: Color = theme_get_color_mode(theme_name, "diff_added", dark);
    let c_rem: Color = theme_get_color_mode(theme_name, "diff_removed", dark);

    let l_hdr: String = border_wrap_line(paint_fg("@@ -1,4 +1,4 @@", c_hdr, color_on, tc_on), 62, border_shape);
    let l_rem: String = border_wrap_line(paint_fg("- legacy_hardcoded_styling()", c_rem, color_on, tc_on), 62, border_shape);
    let l_add: String = border_wrap_line(paint_fg("+ oote_theme_engine_dispatch()", c_add, color_on, tc_on), 62, border_shape);
    return l_hdr + "\n" + l_rem + "\n" + l_add + "\n";
}

fn preview_syntax(theme_name: String, border_shape: String, color_on: Bool, tc_on: Bool, dark: Bool) -> String {
    let c_kw: Color = theme_get_color_mode(theme_name, "syntax_keyword", dark);
    let c_fn: Color = theme_get_color_mode(theme_name, "syntax_fn", dark);
    let c_ty: Color = theme_get_color_mode(theme_name, "syntax_type", dark);
    let c_st: Color = theme_get_color_mode(theme_name, "syntax_string", dark);
    let c_cm: Color = theme_get_color_mode(theme_name, "syntax_comment", dark);

    let w_pub: String = paint_fg("pub fn ", c_kw, color_on, tc_on);
    let w_fn: String = paint_bold("render_theme", c_fn, color_on, tc_on);
    let w_arg: String = paint_fg("() -> ", c_kw, color_on, tc_on);
    let w_ret: String = paint_fg("String", c_ty, color_on, tc_on);
    let w_str: String = paint_fg("\"sovereign\"", c_st, color_on, tc_on);
    let w_cmt: String = paint_fg(" // oote theme", c_cm, color_on, tc_on);
    let line: String = w_pub + w_fn + w_arg + w_ret + " { return " + w_str + "; }" + w_cmt;
    return border_wrap_line(line, 62, border_shape) + "\n";
}

fn preview_shell(theme_name: String, border_shape: String, color_on: Bool, tc_on: Bool, dark: Bool) -> String {
    let c_sh: Color = theme_get_color_mode(theme_name, "shell_prompt", dark);
    let c_nv: Color = theme_get_color_mode(theme_name, "shell_nav", dark);
    let c_bu: Color = theme_get_color_mode(theme_name, "shell_builtin", dark);
    let glyph: String = mascot_glyph(theme_name, "happy");

    let p_ctx: String = paint_fg("openooda " + glyph, c_sh, color_on, tc_on);
    let p_dir: String = paint_bold(" ~/oote", c_nv, color_on, tc_on);
    let p_sym: String = paint_fg(" > ", c_sh, color_on, tc_on);
    let p_cmd: String = paint_fg("oote set " + theme_name, c_bu, color_on, tc_on);
    let line: String = p_ctx + p_dir + p_sym + p_cmd;
    let b_row: String = border_wrap_line(line, 62, border_shape) + "\n";
    let bottom: String = border_bottom_bar(64, border_shape) + "\n";
    return b_row + bottom;
}

pub fn render_preview_card_full(theme_name: String, dark: Bool, border_shape: String, color_on: Bool, tc_on: Bool) -> String {
    let meta: ThemeMeta = theme_get_meta_mode(theme_name, dark);
    let shape: String = if border_is_valid(border_shape) { border_shape } else { "round" };
    let mut out: String = "\n";
    out = out + preview_header(theme_name, meta, shape, color_on, tc_on);
    out = out + preview_mascot(theme_name, shape, color_on, tc_on, dark);
    out = out + preview_swatches(theme_name, shape, color_on, tc_on, dark);
    out = out + preview_diff(theme_name, shape, color_on, tc_on, dark);
    out = out + preview_syntax(theme_name, shape, color_on, tc_on, dark);
    out = out + preview_shell(theme_name, shape, color_on, tc_on, dark);
    return out;
}

pub fn render_preview_card(theme_name: String, color_on: Bool, tc_on: Bool) -> String {
    return render_preview_card_full(theme_name, true, "round", color_on, tc_on);
}
