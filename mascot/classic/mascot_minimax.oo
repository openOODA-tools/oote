// # Minimax Mascot - Sovereign Lynx Companion
//
// Logline: Signature ASCII mascot and micro prompt glyphs for the canonical minimax theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII lynx art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_minimax_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "(^o^)"; }
    if em == "sad" { return "(T.T)"; }
    if em == "alert" { return "(!.!)"; }
    if em == "sleepy" { return "(-.-)z"; }
    return "(^.^)";
}

pub fn mascot_minimax_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_minimax_glyph(em);
    if em == "happy" {
        return mascot_new("minimax", g, " /\\_/\\ ", "( ^.^ )", " > * < ", "  \" \"  ");
    }
    if em == "sad" {
        return mascot_new("minimax", g, " /\\_/\\ ", "( ;.; )", " > v < ", "  \" \"  ");
    }
    if em == "alert" {
        return mascot_new("minimax", g, " /\\_/\\ ", "(!o.o!)", " > ! < ", "  \" \"  ");
    }
    if em == "sleepy" {
        return mascot_new("minimax", g, " /\\_/\\ ", "( -.- )z", " > ~ < ", "  \" \"  ");
    }
    return mascot_new("minimax", g, " /\\_/\\ ", "( o.o )", " > ^ < ", "  \" \"  ");
}
