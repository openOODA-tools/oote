// # 1982 Mascot - Vintage Terminal Droid
//
// Logline: Retro CRT robot ASCII mascot and prompt glyphs for the 1982 theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII robot art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_1982_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "[^_^]"; }
    if em == "sad" { return "[v_v]"; }
    if em == "alert" { return "[!_!]"; }
    if em == "sleepy" { return "[-_-]z"; }
    return "[o_o]";
}

pub fn mascot_1982_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_1982_glyph(em);
    if em == "happy" {
        return mascot_new("1982", g, "  [^-^]  ", "  /[*]\\  ", "   d b   ", "  =====  ");
    }
    if em == "sad" {
        return mascot_new("1982", g, "  [v-v]  ", "  /[!]\\  ", "   d b   ", "  =====  ");
    }
    if em == "alert" {
        return mascot_new("1982", g, "  [!_!]  ", "  /[?Item]\\", "   d b   ", "  =====  ");
    }
    if em == "sleepy" {
        return mascot_new("1982", g, "  [-_-]z ", "  /[ ]\\  ", "   d b   ", "  =====  ");
    }
    return mascot_new("1982", g, "  [o_o]  ", "  /[ ]\\  ", "   d b   ", "  =====  ");
}
