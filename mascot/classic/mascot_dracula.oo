// # Dracula Mascot - Gothic Vampire Bat
//
// Logline: Little vampire bat ASCII mascot and prompt glyphs for the dracula theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII vampire bat art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_dracula_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "/|^,^|\\"; }
    if em == "sad" { return "/|v,v|\\"; }
    if em == "alert" { return "/|!,!|\\"; }
    if em == "sleepy" { return "/|-,-|\\"; }
    return "/|o,o|\\";
}

pub fn mascot_dracula_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_dracula_glyph(em);
    if em == "happy" {
        return mascot_new("dracula", g, " /|___|\\ ", " ( ^,^ ) ", "  \\ * /  ", "   w w   ");
    }
    if em == "sad" {
        return mascot_new("dracula", g, " /|___|\\ ", " ( v,v ) ", "  \\ ; /  ", "   w w   ");
    }
    if em == "alert" {
        return mascot_new("dracula", g, " /|___|\\ ", " (!o,o!) ", "  \\ ! /  ", "   w w   ");
    }
    if em == "sleepy" {
        return mascot_new("dracula", g, " /|___|\\ ", " ( -,- )z", "  \\ ~ /  ", "   w w   ");
    }
    return mascot_new("dracula", g, " /|___|\\ ", " ( o,o ) ", "  \\ v /  ", "   w w   ");
}
