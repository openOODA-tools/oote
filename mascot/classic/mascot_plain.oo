// # Plain Mascot - Minimal Terminal Container
//
// Logline: Minimal terminal box ASCII mascot and prompt glyphs for the plain monochrome theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII frame art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_plain_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "[^]"; }
    if em == "sad" { return "[v]"; }
    if em == "alert" { return "[!]"; }
    if em == "sleepy" { return "[-]z"; }
    return "[_]";
}

pub fn mascot_plain_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_plain_glyph(em);
    if em == "happy" {
        return mascot_new("plain", g, " +---+ ", " | ^ | ", " +---+ ", "       ");
    }
    if em == "sad" {
        return mascot_new("plain", g, " +---+ ", " | v | ", " +---+ ", "       ");
    }
    if em == "alert" {
        return mascot_new("plain", g, " +---+ ", " | ! | ", " +---+ ", "       ");
    }
    if em == "sleepy" {
        return mascot_new("plain", g, " +---+ ", " | - |z", " +---+ ", "       ");
    }
    return mascot_new("plain", g, " +---+ ", " |   | ", " +---+ ", "       ");
}
