// # Spooky Mascot - Haunted Halloween Phantom
//
// Logline: Haunted phantom ghost ASCII mascot and prompt glyphs for the spooky holiday theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII ghost art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_spooky_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "[O.O]"; }
    if em == "sad" { return "[u.u]"; }
    if em == "alert" { return "[!_!]"; }
    if em == "sleepy" { return "[-.-]z"; }
    return "[o.o]";
}

pub fn mascot_spooky_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_spooky_glyph(em);
    if em == "happy" {
        return mascot_new("spooky", g, "   .-.   ", "  (^ ^) *", "  | O |  ", "  '~~~'  ");
    }
    if em == "sad" {
        return mascot_new("spooky", g, "   .-.   ", "  (u u)  ", "  | o |  ", "  '~~~'  ");
    }
    if em == "alert" {
        return mascot_new("spooky", g, "   .-.   ", "  (! !) ! ", "  | O |  ", "  '~~~'  ");
    }
    if em == "sleepy" {
        return mascot_new("spooky", g, "   .-.   ", "  (- -) z", "  | - |  ", "  '~~~'  ");
    }
    return mascot_new("spooky", g, "   .-.   ", "  (o o)  ", "  | O |  ", "  '~~~'  ");
}
