// # Harvest Mascot - Thanksgiving Cornucopia Turkey
//
// Logline: Cornucopia turkey ASCII mascot and prompt glyphs for the harvest holiday theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII turkey art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_harvest_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return ">°*°<"; }
    if em == "sad" { return ">°v°<"; }
    if em == "alert" { return ">°!°<"; }
    if em == "sleepy" { return ">°-°<z"; }
    return ">°o°<";
}

pub fn mascot_harvest_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_harvest_glyph(em);
    if em == "happy" {
        return mascot_new("harvest", g, "   /|\\   ", "  (^ ^)* ", "   >|<   ", "   w w   ");
    }
    if em == "sad" {
        return mascot_new("harvest", g, "   /|\\   ", "  (v v)  ", "   >|<   ", "   w w   ");
    }
    if em == "alert" {
        return mascot_new("harvest", g, "   /!\\   ", "  (! !) ! ", "   >|<   ", "   w w   ");
    }
    if em == "sleepy" {
        return mascot_new("harvest", g, "   /|\\   ", "  (- -)z ", "   >|<   ", "   w w   ");
    }
    return mascot_new("harvest", g, "   /|\\   ", "  (o o)  ", "   >|<   ", "   w w   ");
}
