// # Sol Mascot - Helios Solar Lion
//
// Logline: Helios solar lion ASCII mascot and prompt glyphs for the sol holiday theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII lion art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_sol_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "(>*<)"; }
    if em == "sad" { return "(>v<)"; }
    if em == "alert" { return "(>!<)"; }
    if em == "sleepy" { return "(>-<)z"; }
    return "(>o<)";
}

pub fn mascot_sol_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_sol_glyph(em);
    if em == "happy" {
        return mascot_new("sol", g, " (|'*'|)", "  \\ * / ", "   m m  ", "  * * * ");
    }
    if em == "sad" {
        return mascot_new("sol", g, " (|';'|)", "  \\ v / ", "   m m  ", "  ; ; ; ");
    }
    if em == "alert" {
        return mascot_new("sol", g, " (|'!'|)", "  \\ ! / ", "   m m  ", "  ! ! ! ");
    }
    if em == "sleepy" {
        return mascot_new("sol", g, " (|'-'|)z", "  \\ ~ / ", "   m m  ", "  . . . ");
    }
    return mascot_new("sol", g, " (|'o'|)", "  \\ - / ", "   m m  ", "  * * * ");
}
