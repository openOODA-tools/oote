// # Mirage Mascot - Desert Fennec Fox
//
// Logline: Desert fennec fox ASCII mascot and prompt glyphs for the mirage theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII fennec fox art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_mirage_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "|^'^|"; }
    if em == "sad" { return "|^v^|"; }
    if em == "alert" { return "|^!^|"; }
    if em == "sleepy" { return "|^~^|z"; }
    return "|'o'|";
}

pub fn mascot_mirage_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_mirage_glyph(em);
    if em == "happy" {
        return mascot_new("mirage", g, " /|   |\\ ", "(  ^.^  )", "  > * <  ", "   \" \"   ");
    }
    if em == "sad" {
        return mascot_new("mirage", g, " /|   |\\ ", "(  v.v  )", "  > ; <  ", "   \" \"   ");
    }
    if em == "alert" {
        return mascot_new("mirage", g, " /|   |\\ ", "(! o.o !)", "  > ! <  ", "   \" \"   ");
    }
    if em == "sleepy" {
        return mascot_new("mirage", g, " /|   |\\ ", "(  -.-  )z", "  > ~ <  ", "   \" \"   ");
    }
    return mascot_new("mirage", g, " /|   |\\ ", "(  o.o  )", "  > * <  ", "   \" \"   ");
}
