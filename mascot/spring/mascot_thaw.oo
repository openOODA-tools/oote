// # Thaw Mascot - River Otter
//
// Logline: River otter ASCII mascot and prompt glyphs for the thaw theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII otter art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_thaw_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "(~)^(~)"; }
    if em == "sad" { return "(~)v(~)"; }
    if em == "alert" { return "(~)!(~)"; }
    if em == "sleepy" { return "(~)z(~)"; }
    return "(~)o(~)";
}

pub fn mascot_thaw_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_thaw_glyph(em);
    if em == "happy" {
        return mascot_new("thaw", g, "   .~.   ", "  (^.^)* ", "  (\")(\") ", "  ~~~~~  ");
    }
    if em == "sad" {
        return mascot_new("thaw", g, "   .~.   ", "  (;.;)  ", "  (\")(\") ", "  ~~~~~  ");
    }
    if em == "alert" {
        return mascot_new("thaw", g, "   .~.   ", "  (!o!)  ", "  (\")(\") ", "  ~~~~~  ");
    }
    if em == "sleepy" {
        return mascot_new("thaw", g, "   .~.   ", "  (-.-)z ", "  (\")(\") ", "  ~~~~~  ");
    }
    return mascot_new("thaw", g, "   .~.   ", "  (o.o)  ", "  (\")(\") ", "  ~~~~~  ");
}
