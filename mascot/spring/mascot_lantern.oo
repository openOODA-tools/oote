// # Lantern Mascot - Lunar Festive Dragon
//
// Logline: Festive lucky dragon ASCII mascot and prompt glyphs for the lantern holiday theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII dragon art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_lantern_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "=^^="; }
    if em == "sad" { return "=vv="; }
    if em == "alert" { return "=!!="; }
    if em == "sleepy" { return "==zz"; }
    return "=oO=";
}

pub fn mascot_lantern_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_lantern_glyph(em);
    if em == "happy" {
        return mascot_new("lantern", g, "  ~~~~~  ", " ( ^ ^ )*", "  \\_V_/  ", "   * *   ");
    }
    if em == "sad" {
        return mascot_new("lantern", g, "  ~~~~~  ", " ( v v ) ", "  \\_V_/  ", "   ; ;   ");
    }
    if em == "alert" {
        return mascot_new("lantern", g, "  ~~~~~  ", " (!O O!) ", "  \\_V_/  ", "   ! !   ");
    }
    if em == "sleepy" {
        return mascot_new("lantern", g, "  ~~~~~  ", " ( - - )z", "  \\_V_/  ", "   ~ ~   ");
    }
    return mascot_new("lantern", g, "  ~~~~~  ", " ( o O ) ", "  \\_V_/  ", "   * *   ");
}
