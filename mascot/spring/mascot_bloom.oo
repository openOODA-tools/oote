// # Bloom Mascot - Spring Blossom Butterfly
//
// Logline: Spring butterfly ASCII mascot and prompt glyphs for the bloom theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII butterfly art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_bloom_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "\\^/"; }
    if em == "sad" { return "\\v/"; }
    if em == "alert" { return "\\!/"; }
    if em == "sleepy" { return "\\~/z"; }
    return "\\o/";
}

pub fn mascot_bloom_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_bloom_glyph(em);
    if em == "happy" {
        return mascot_new("bloom", g, "   \\/    ", " <(^.^)> ", "   /\\    ", "  * * *  ");
    }
    if em == "sad" {
        return mascot_new("bloom", g, "   \\/    ", " <(;.;)> ", "   /\\    ", "  * * *  ");
    }
    if em == "alert" {
        return mascot_new("bloom", g, "   \\/    ", " <(!o!)> ", "   /\\    ", "  ! ! !  ");
    }
    if em == "sleepy" {
        return mascot_new("bloom", g, "   \\/    ", " <(-.-)>z", "   /\\    ", "  . . .  ");
    }
    return mascot_new("bloom", g, "   \\/    ", " <(o.o)> ", "   /\\    ", "  * * *  ");
}
