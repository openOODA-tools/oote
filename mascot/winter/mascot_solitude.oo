// # Solitude Mascot - Silent Mountain Wolf
//
// Logline: Mountain wolf ASCII mascot and prompt glyphs for the solitude theme.
//
// Setup: Pure string assembly. Relies on mascot_model.oo.
//
// Beats:
//   1. Construct micro prompt glyphs per emotional state.
//   2. Construct multi-line ASCII wolf art per emotional state.
//   3. Dispatch emotion state queries to structured Mascot record.

import "mascot/mascot_model.oo";

pub fn mascot_solitude_glyph(emotion: String) -> String {
    let em: String = normalize_emotion(emotion);
    if em == "happy" { return "|^.^|"; }
    if em == "sad" { return "|;.;|"; }
    if em == "alert" { return "|!.!|"; }
    if em == "sleepy" { return "|-.-|z"; }
    return "|o.o|";
}

pub fn mascot_solitude_data(emotion: String) -> Mascot {
    let em: String = normalize_emotion(emotion);
    let g: String = mascot_solitude_glyph(em);
    if em == "happy" {
        return mascot_new("solitude", g, "   / \\   ", "  /^ ^\\  ", " ( =*= ) ", "   m-m   ");
    }
    if em == "sad" {
        return mascot_new("solitude", g, "   / \\   ", "  /; ;\\  ", " ( =v= ) ", "   m-m   ");
    }
    if em == "alert" {
        return mascot_new("solitude", g, "   / \\   ", "  /! !\\  ", " ( =!= ) ", "   m-m   ");
    }
    if em == "sleepy" {
        return mascot_new("solitude", g, "   / \\   ", "  /- -\\z ", " ( =~= ) ", "   m-m   ");
    }
    return mascot_new("solitude", g, "   / \\   ", "  /o o\\  ", " ( =^= ) ", "   m-m   ");
}
